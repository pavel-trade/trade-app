//@version=6
// ============================================================================
// TW Карта рынка
// Один индикатор на графике цены для ручного волнового анализа Эллиотта:
// слепая зона, ZigZag, ручная разметка с проверкой жёстких правил, последний импульс и
// коррекция A -> B -> C, каналы, Anchored VWAP, профиль объёма, правило 100-140, риск,
// чек-лист «Зона -> Истощение -> Триггер».
// Методика: tradewaves.ru, Б. Вильямс, pr0 / RSWA. Скорость и ускорение рисует отдельный
// индикатор «TW Спидометр»; здесь они считаются внутри только для чек-листа.
// Это подсказка для анализа, не торговая система и не сигнал к сделке.
// Механическая версия сетапа на BTC 2022-2026 устойчивого преимущества не показала.
// Эталон для сверки: reference/map.py
// ============================================================================
indicator("TW Карта рынка", shorttitle = "TW Карта", overlay = true, precision = 2,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_polylines_count = 10)

// ============================================================================
// 0. Общее: детализация, тема, палитра
// ============================================================================
const string G0 = "0. Общее"
const string DL_MIN = "Минимум"
const string DL_STD = "Стандарт"
const string DL_ALL = "Всё"
const string T_AUTO = "Авто (по фону графика)"
const string T_LIGHT = "Светлая"
const string T_DARK = "Тёмная"
string detailIn = input.string(DL_STD, "Детализация", options = [DL_MIN, DL_STD, DL_ALL], group = G0,
     tooltip = "Минимум — только линии и ключевые уровни. Стандарт — плюс подписи цен, зоны Фибоначчи, цели 1.0 и 1.618, бары профиля. Всё — плюс информация о ногах, цель 2.618, параллель через 1, подписи всех уровней.")
string themeIn = input.string(T_AUTO, "Тема", options = [T_AUTO, T_LIGHT, T_DARK], group = G0,
     tooltip = "«Авто» — по яркости фона графика (chart.bg_color).")
int lblOffset = input.int(8, "Отступ подписей уровней справа, баров", minval = 1, maxval = 100, group = G0)

int dl = detailIn == DL_MIN ? 0 : detailIn == DL_STD ? 1 : 2

color bgC = chart.bg_color
bool autoDark = color.r(bgC) * 0.299 + color.g(bgC) * 0.587 + color.b(bgC) * 0.114 < 128
bool isDark = themeIn == T_AUTO ? autoDark : themeIn == T_DARK

// Палитра Okabe-Ito (различима при дальтонизме); смысл дублируется подписями и таблицами.
color C_UP = isDark ? #56B4E9 : #0072B2        // рост / бычье / быстрая EMA выше
color C_DN = isDark ? #E69F00 : #D55E00        // спад / медвежье / быстрая EMA ниже
color C_OK = #009E73                           // цели, «✓»
color C_ACC = #CC79A7                          // ZigZag, разметка
color C_VW = isDark ? #F0E442 : #8C7A00        // VWAP
color C_TX = isDark ? #D1D4DC : #131722
color C_MUTED = isDark ? #787B86 : #9598A1
color C_BG = isDark ? color.new(#1E222D, 5) : color.new(#F0F3FA, 5)
color C_HD = isDark ? #2A2E39 : #DDE2EC

// ============================================================================
// M1. Слепая зона и средние
// ============================================================================
const string G1 = "1. Слепая зона и средние"
bool m1On = input.bool(true, "Включить модуль", group = G1)
int fastLen = input.int(5, "EMA быстрая", minval = 1, group = G1, inline = "e")
int slowLen = input.int(34, "медленная", minval = 2, group = G1, inline = "e",
     tooltip = "Те же периоды задают внутреннюю скорость для чек-листа (как в «TW Спидометр»).")
bool emaLog = input.bool(true, "EMA от логарифма цены", group = G1,
     tooltip = "EMA считается от ln(close) и переводится обратно в цену (геометрическое среднее), как в спидометре. Выключите для обычных EMA.")
bool showFill = input.bool(true, "Заливка между EMA", group = G1)
bool showZones = input.bool(true, "Прямоугольники слепых зон", group = G1,
     tooltip = "От экстремума режима (EMA быстрая выше/ниже медленной) до пересечения EMA. Рисуется после пересечения.")
bool showLiveBz = input.bool(true, "Подсветка «внутри живой слепой зоны»", group = G1,
     tooltip = "Цена ушла от экстремума против режима EMA, а пересечения ещё нет. Если цена обновит экстремум, подсвеченные бары останутся: это возможная слепая зона.")
bool showSma200 = input.bool(true, "SMA 200", group = G1, inline = "m")
bool showEma20 = input.bool(false, "EMA 20", group = G1, inline = "m")
bool showEma50 = input.bool(false, "EMA 50", group = G1, inline = "m")
int maxZones = input.int(40, "Хранить последних зон", minval = 1, maxval = 150, group = G1)
if slowLen <= fastLen
    runtime.error("Медленная EMA должна быть больше быстрой.")

float lsrc = emaLog ? math.log(close) : close
float emaF = ta.ema(lsrc, fastLen)
float emaS = ta.ema(lsrc, slowLen)
float emaFP = emaLog ? math.exp(emaF) : emaF
float emaSP = emaLog ? math.exp(emaS) : emaS
float sma200 = ta.sma(close, 200)
float ema20 = ta.ema(close, 20)
float ema50 = ta.ema(close, 50)

// Внутренняя скорость и ускорение (не рисуются): те же формулы, что в «TW Спидометр».
float spSrc = 100.0 * math.log(close)
float speed = ta.ema(spSrc, fastLen) - ta.ema(spSrc, slowLen)
float accel = speed - ta.ema(speed, 5)

// Слепая зона: состояние «на ходу» через var, без циклов по истории.
var int bzReg = 0
var float bzExt = na
var int bzExtBar = na
var float bzOpp = na
float emaDiff = emaF - emaS
int bzNew = emaDiff > 0 ? 1 : emaDiff < 0 ? -1 : bzReg
if bzReg == 1
    if high > bzExt
        bzExt := high
        bzExtBar := bar_index
        bzOpp := low
    else
        bzOpp := math.min(bzOpp, low)
else if bzReg == -1
    if low < bzExt
        bzExt := low
        bzExtBar := bar_index
        bzOpp := high
    else
        bzOpp := math.max(bzOpp, high)

bool emaCross = false
int zReg = 0
int zLeft = na
float zExt = na
float zOpp = na
if bzNew != bzReg and bzNew != 0
    if bzReg != 0
        emaCross := true
        zReg := bzReg
        zLeft := bzExtBar
        zExt := bzExt
        zOpp := bzOpp
    bzExt := bzNew == 1 ? high : low
    bzExtBar := bar_index
    bzOpp := bzNew == 1 ? low : high
bzReg := bzNew

var array<box> bzBoxes = array.new<box>()
if m1On and showZones and emaCross
    color zc = zReg == 1 ? C_UP : C_DN
    bzBoxes.push(box.new(zLeft, zReg == 1 ? zExt : zOpp, bar_index, zReg == 1 ? zOpp : zExt,
         border_color = color.new(zc, 50), bgcolor = color.new(zc, 88),
         text = dl >= 1 ? "слепая зона " + str.tostring(bar_index - zLeft) + " бар." : "слепая зона",
         text_size = size.tiny, text_color = color.new(C_TX, 30), text_valign = text.align_top, text_halign = text.align_left))
    if bzBoxes.size() > maxZones
        bzBoxes.shift().delete()

bool inLiveBz = bzReg != 0 and bar_index > bzExtBar
bgcolor(m1On and showLiveBz and inLiveBz ? color.new(bzReg == 1 ? C_UP : C_DN, 93) : na, title = "Внутри живой слепой зоны")

pF = plot(m1On ? emaFP : na, "EMA быстрая", color = C_UP, linewidth = 1)
pS = plot(m1On ? emaSP : na, "EMA медленная", color = C_DN, linewidth = 2)
fill(pF, pS, color = m1On and showFill ? (emaDiff > 0 ? color.new(C_UP, 85) : color.new(C_DN, 85)) : na, title = "Заливка EMA")
plot(m1On and showSma200 ? sma200 : na, "SMA 200", color = color.new(C_TX, 25), linewidth = 2)
plot(m1On and showEma20 ? ema20 : na, "EMA 20", color = color.new(C_OK, 0), linewidth = 1)
plot(m1On and showEma50 ? ema50 : na, "EMA 50", color = color.new(C_ACC, 0), linewidth = 1)

// ============================================================================
// M2. ZigZag и точки разворота
// Свинги хранятся в массивах и чередуются (два максимума подряд — остаётся больший,
// два минимума — меньший). Для каждой ноги копятся пик скорости, объём и число баров
// по полуоткрытому отрезку (предыдущий свинг; свинг]. В режиме пивотов накопление идёт
// с лагом L баров (бар i - L), поэтому к моменту подтверждения пивота нога посчитана ровно
// до его бара — без циклов по истории.
// ============================================================================
const string G2 = "2. ZigZag и точки разворота"
const string Z_PIV = "Пивоты (L баров)"
const string Z_PCT = "Процентный ZigZag"
bool m2Show = input.bool(true, "Показывать ZigZag", group = G2,
     tooltip = "Свинги считаются всегда — на них опираются модули 4 и 6-10. Переключатель отвечает только за отрисовку.")
string zzMode = input.string(Z_PIV, "Режим", options = [Z_PIV, Z_PCT], group = G2,
     tooltip = "Пивоты: ta.pivothigh/ta.pivotlow длины L — свинг подтверждается через L баров. Процентный: разворот, когда цена ушла от экстремума на заданный %.")
int zzLen = input.int(10, "Длина пивота L", minval = 2, maxval = 50, group = G2)
float zzPct = input.float(5.0, "Порог процентного ZigZag, %", minval = 0.1, maxval = 50.0, step = 0.5, group = G2)
int minorLen = input.int(3, "Малые пивоты (первый триггер)", minval = 1, maxval = 10, group = G2,
     tooltip = "Малые пивоты используются для «первого триггера» — последнего локального экстремума внутри коррекции.")
bool legInfoIn = input.bool(false, "Информация о ногах: %, бары, объём/бар", group = G2,
     tooltip = "В детализации «Всё» включается автоматически.")
int maxSwDraw = input.int(30, "Рисовать последних свингов", minval = 5, maxval = 100, group = G2)

bool isPiv = zzMode == Z_PIV
int L = zzLen
bool legInfo = legInfoIn or dl == 2

// ta.* — на глобальном уровне, на каждом баре
float phMaj = ta.pivothigh(high, L, L)
float plMaj = ta.pivotlow(low, L, L)
float phMin = ta.pivothigh(high, minorLen, minorLen)
float plMin = ta.pivotlow(low, minorLen, minorLen)
float spdHiL = ta.highest(speed, L)
float spdLoL = ta.lowest(speed, L)
float volZ = nz(volume)
float volSumL = math.sum(volZ, L)
float loL = ta.lowest(low, L)
int loLOff = ta.lowestbars(low, L)
float hiL = ta.highest(high, L)
int hiLOff = ta.highestbars(high, L)

var float cumPV = 0.0
var float cumV = 0.0
cumPV += hlc3 * volZ
cumV += volZ
var bool hasVol = false
if volZ > 0
    hasVol := true

// свинги и ноги (нога i закончилась в свинге i)
const int MAX_SW = 60
var array<int> swBar = array.new<int>()
var array<float> swPx = array.new<float>()
var array<int> swDir = array.new<int>()
var array<float> swSpd = array.new<float>()
var array<float> swPV0 = array.new<float>()
var array<float> swV0 = array.new<float>()
var array<float> lgMx = array.new<float>()
var array<float> lgMn = array.new<float>()
var array<float> lgVol = array.new<float>()
var array<int> lgN = array.new<int>()

f_mx(float a, float b) =>
    na(a) ? b : na(b) ? a : math.max(a, b)

f_mn(float a, float b) =>
    na(a) ? b : na(b) ? a : math.min(a, b)

f_swPush(int b, float p, int d, float sp, float pv0, float v0, float mx, float mn, float vl, int n) =>
    swBar.push(b)
    swPx.push(p)
    swDir.push(d)
    swSpd.push(sp)
    swPV0.push(pv0)
    swV0.push(v0)
    lgMx.push(mx)
    lgMn.push(mn)
    lgVol.push(vl)
    lgN.push(n)
    if swBar.size() > MAX_SW
        swBar.shift()
        swPx.shift()
        swDir.shift()
        swSpd.shift()
        swPV0.shift()
        swV0.shift()
        lgMx.shift()
        lgMn.shift()
        lgVol.shift()
        lgN.shift()

f_swSetLast(int b, float p, float sp, float pv0, float v0, float mx, float mn, float vl, int n) =>
    int k = swBar.size() - 1
    swBar.set(k, b)
    swPx.set(k, p)
    swSpd.set(k, sp)
    swPV0.set(k, pv0)
    swV0.set(k, v0)
    lgMx.set(k, mx)
    lgMn.set(k, mn)
    lgVol.set(k, vl)
    lgN.set(k, n)

// --- отрисовка свингов: линия от предыдущего свинга и подпись; при замене — set_*
var array<line> zzLines = array.new<line>()
var array<label> zzLabels = array.new<label>()

f_swText(int k) =>
    string t = str.tostring(swPx.get(k), format.mintick)
    if legInfo and k > 0
        float p0 = swPx.get(k - 1)
        int n = lgN.get(k)
        float va = n > 0 and hasVol ? lgVol.get(k) / n : na
        t += "\n" + (swPx.get(k) >= p0 ? "+" : "") + str.tostring((swPx.get(k) / p0 - 1) * 100, "0.0") + " %, " +
             str.tostring(swBar.get(k) - swBar.get(k - 1)) + " бар." + (na(va) ? "" : ", об./бар " + str.tostring(va, format.volume))
    t

f_drawSwing(bool replaced) =>
    if m2Show
        int k = swBar.size() - 1
        int d = swDir.get(k)
        string st = d == 1 ? label.style_label_down : label.style_label_up
        if replaced and zzLabels.size() > 0
            label lb = zzLabels.last()
            lb.set_xy(swBar.get(k), swPx.get(k))
            lb.set_text(dl >= 1 ? f_swText(k) : "")
            if k > 0 and zzLines.size() > 0
                zzLines.last().set_xy2(swBar.get(k), swPx.get(k))
        else
            if k > 0
                zzLines.push(line.new(swBar.get(k - 1), swPx.get(k - 1), swBar.get(k), swPx.get(k), color = C_ACC, width = 2))
            zzLabels.push(label.new(swBar.get(k), swPx.get(k), dl >= 1 ? f_swText(k) : "", style = st,
                 color = color.new(C_ACC, dl >= 1 ? 80 : 100), textcolor = C_TX, size = size.tiny))
            if zzLines.size() > maxSwDraw
                zzLines.shift().delete()
            if zzLabels.size() > maxSwDraw
                zzLabels.shift().delete()

// накопитель текущей ноги и текущий (незавершённый) экстремум против последнего свинга
var float aMx = na
var float aMn = na
var float aVol = 0.0
var int aN = 0
var float rnPx = na
var int rnBar = na
var float rnSpd = na
var float rnPV0 = na
var float rnV0 = na
bool newSwing = false

if isPiv
    // нога копится с лагом L баров
    if bar_index >= L
        aMx := f_mx(aMx, speed[L])
        aMn := f_mn(aMn, speed[L])
        aVol += volZ[L]
        aN += 1
    // текущий экстремум обновляется текущим баром
    if swBar.size() > 0 and not na(rnPx)
        if swDir.last() == 1 and low < rnPx
            rnPx := low
            rnBar := bar_index
            rnSpd := speed
            rnPV0 := nz(cumPV[1])
            rnV0 := nz(cumV[1])
        else if swDir.last() == -1 and high > rnPx
            rnPx := high
            rnBar := bar_index
            rnSpd := speed
            rnPV0 := nz(cumPV[1])
            rnV0 := nz(cumV[1])
    int firstD = swDir.size() > 0 and swDir.last() == 1 ? -1 : 1
    for k = 0 to 1
        int d = k == 0 ? firstD : -firstD
        float pv = d == 1 ? phMaj : plMaj
        if not na(pv)
            bool same = swDir.size() > 0 and swDir.last() == d
            bool doIt = not same or (d == 1 ? pv > swPx.last() : pv < swPx.last())
            if doIt
                if same
                    int kk = swBar.size() - 1
                    f_swSetLast(bar_index - L, pv, speed[L], nz(cumPV[L + 1]), nz(cumV[L + 1]),
                         f_mx(lgMx.get(kk), aMx), f_mn(lgMn.get(kk), aMn), lgVol.get(kk) + aVol, lgN.get(kk) + aN)
                else
                    f_swPush(bar_index - L, pv, d, speed[L], nz(cumPV[L + 1]), nz(cumV[L + 1]), aMx, aMn, aVol, aN)
                f_drawSwing(same)
                aMx := na
                aMn := na
                aVol := 0.0
                aN := 0
                newSwing := true
                // экстремум против нового свинга на отрезке (пивот; текущий бар]
                int off = d == 1 ? loLOff : hiLOff
                rnPx := d == 1 ? loL : hiL
                rnBar := bar_index + off
                rnSpd := speed[-off]
                rnPV0 := nz(cumPV[-off + 1])
                rnV0 := nz(cumV[-off + 1])

// процентный ZigZag: кандидат-экстремум, «снимок» ноги на баре кандидата и нога после кандидата
var int zDir = 1
var float snMx = na
var float snMn = na
var float snVol = 0.0
var int snN = 0
var float siMx = na
var float siMn = na
var float siVol = 0.0
var int siN = 0
if not isPiv
    aMx := f_mx(aMx, speed)
    aMn := f_mn(aMn, speed)
    aVol += volZ
    aN += 1
    siMx := f_mx(siMx, speed)
    siMn := f_mn(siMn, speed)
    siVol += volZ
    siN += 1
    float thr = zzPct / 100.0
    bool newCand = false
    bool confirm = false
    if na(rnPx)
        newCand := true
    else if zDir == 1
        if high > rnPx
            newCand := true
        else if low <= rnPx * (1 - thr)
            confirm := true
    else
        if low < rnPx
            newCand := true
        else if high >= rnPx * (1 + thr)
            confirm := true
    if confirm
        f_swPush(rnBar, rnPx, zDir, rnSpd, rnPV0, rnV0, snMx, snMn, snVol, snN)
        f_drawSwing(false)
        newSwing := true
        aMx := siMx
        aMn := siMn
        aVol := siVol
        aN := siN
        zDir := -zDir
        newCand := true
    if newCand
        rnPx := zDir == 1 ? high : low
        rnBar := bar_index
        rnSpd := speed
        rnPV0 := nz(cumPV[1])
        rnV0 := nz(cumV[1])
        snMx := aMx
        snMn := aMn
        snVol := aVol
        snN := aN
        siMx := na
        siMn := na
        siVol := 0.0
        siN := 0

bool hasRun = swBar.size() > 0 and not na(rnPx)
// статистика текущей (незавершённой) ноги (последний свинг; сейчас]
float rlMx = isPiv ? f_mx(aMx, spdHiL) : aMx
float rlMn = isPiv ? f_mn(aMn, spdLoL) : aMn
float rlVol = isPiv ? aVol + nz(volSumL) : aVol
int rlN = isPiv ? aN + L : aN

// малые пивоты (для «первого триггера»)
const int MAX_MINOR = 40
var array<int> mhBar = array.new<int>()
var array<float> mhPx = array.new<float>()
var array<int> mlBar = array.new<int>()
var array<float> mlPx = array.new<float>()
if not na(phMin)
    mhBar.push(bar_index - minorLen)
    mhPx.push(phMin)
    if mhBar.size() > MAX_MINOR
        mhBar.shift()
        mhPx.shift()
if not na(plMin)
    mlBar.push(bar_index - minorLen)
    mlPx.push(plMin)
    if mlBar.size() > MAX_MINOR
        mlBar.shift()
        mlPx.shift()

// последний незавершённый отрезок — пунктиром, с пометкой о возможной перерисовке
var line zzLive = na
var label zzLiveLbl = na
if barstate.islast and m2Show and hasRun
    int kL = swBar.size() - 1
    if na(zzLive)
        zzLive := line.new(swBar.get(kL), swPx.get(kL), rnBar, rnPx, color = color.new(C_ACC, 30), width = 1, style = line.style_dashed)
        zzLiveLbl := label.new(rnBar, rnPx, "", color = color.new(C_ACC, 100), textcolor = C_MUTED, size = size.tiny)
    zzLive.set_xy1(swBar.get(kL), swPx.get(kL))
    zzLive.set_xy2(rnBar, rnPx)
    zzLiveLbl.set_xy(rnBar, rnPx)
    zzLiveLbl.set_style(swDir.get(kL) == 1 ? label.style_label_up : label.style_label_down)
    zzLiveLbl.set_text(dl >= 1 ? "не подтверждён — может перерисоваться" : "?")
