//@version=6
// ============================================================================
// TW Карта рынка
// Один индикатор на графике цены для ручного волнового анализа Эллиотта:
// слепая зона, ZigZag, ручная разметка с проверкой жёстких правил, последний импульс и
// коррекция A -> B -> C, каналы, Anchored VWAP, профиль объёма, правило 100-140, риск,
// чек-лист «Зона -> Истощение -> Триггер».
// Методика: tradewaves.ru, Б. Вильямс, pr0 / RSWA. Скорость и ускорение рисует отдельный
// индикатор «TW Спидометр»; здесь они считаются внутри только для чек-листа.
// Это подсказка для анализа, не торговая система и не сигнал к сделке.
// Механическая версия сетапа на BTC 2022-2026 устойчивого преимущества не показала.
// Эталон для сверки: reference/map.py
// ============================================================================
indicator("TW Карта рынка", shorttitle = "TW Карта", overlay = true, precision = 2,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_polylines_count = 10)

// ============================================================================
// 0. Общее: детализация, тема, палитра
// ============================================================================
const string G0 = "0. Общее"
const string DL_MIN = "Минимум"
const string DL_STD = "Стандарт"
const string DL_ALL = "Всё"
const string T_AUTO = "Авто (по фону графика)"
const string T_LIGHT = "Светлая"
const string T_DARK = "Тёмная"
string detailIn = input.string(DL_STD, "Детализация", options = [DL_MIN, DL_STD, DL_ALL], group = G0,
     tooltip = "Минимум — только линии и ключевые уровни. Стандарт — плюс подписи цен, зоны Фибоначчи, цели 1.0 и 1.618, бары профиля. Всё — плюс информация о ногах, цель 2.618, параллель через 1, подписи всех уровней.")
string themeIn = input.string(T_AUTO, "Тема", options = [T_AUTO, T_LIGHT, T_DARK], group = G0,
     tooltip = "«Авто» — по яркости фона графика (chart.bg_color).")
int lblOffset = input.int(8, "Отступ подписей уровней справа, баров", minval = 1, maxval = 100, group = G0)

int dl = detailIn == DL_MIN ? 0 : detailIn == DL_STD ? 1 : 2

color bgC = chart.bg_color
bool autoDark = color.r(bgC) * 0.299 + color.g(bgC) * 0.587 + color.b(bgC) * 0.114 < 128
bool isDark = themeIn == T_AUTO ? autoDark : themeIn == T_DARK

// Палитра Okabe-Ito (различима при дальтонизме); смысл дублируется подписями и таблицами.
color C_UP = isDark ? #56B4E9 : #0072B2        // рост / бычье / быстрая EMA выше
color C_DN = isDark ? #E69F00 : #D55E00        // спад / медвежье / быстрая EMA ниже
color C_OK = #009E73                           // цели, «✓»
color C_ACC = #CC79A7                          // ZigZag, разметка
color C_VW = isDark ? #F0E442 : #8C7A00        // VWAP
color C_TX = isDark ? #D1D4DC : #131722
color C_MUTED = isDark ? #787B86 : #9598A1
color C_BG = isDark ? color.new(#1E222D, 5) : color.new(#F0F3FA, 5)
color C_HD = isDark ? #2A2E39 : #DDE2EC

// ============================================================================
// M1. Слепая зона и средние
// ============================================================================
const string G1 = "1. Слепая зона и средние"
bool m1On = input.bool(true, "Включить модуль", group = G1)
int fastLen = input.int(5, "EMA быстрая", minval = 1, group = G1, inline = "e")
int slowLen = input.int(34, "медленная", minval = 2, group = G1, inline = "e",
     tooltip = "Те же периоды задают внутреннюю скорость для чек-листа (как в «TW Спидометр»).")
bool emaLog = input.bool(true, "EMA от логарифма цены", group = G1,
     tooltip = "EMA считается от ln(close) и переводится обратно в цену (геометрическое среднее), как в спидометре. Выключите для обычных EMA.")
bool showFill = input.bool(true, "Заливка между EMA", group = G1)
bool showZones = input.bool(true, "Прямоугольники слепых зон", group = G1,
     tooltip = "От экстремума режима (EMA быстрая выше/ниже медленной) до пересечения EMA. Рисуется после пересечения.")
bool showLiveBz = input.bool(true, "Подсветка «внутри живой слепой зоны»", group = G1,
     tooltip = "Цена ушла от экстремума против режима EMA, а пересечения ещё нет. Если цена обновит экстремум, подсвеченные бары останутся: это возможная слепая зона.")
bool showSma200 = input.bool(true, "SMA 200", group = G1, inline = "m")
bool showEma20 = input.bool(false, "EMA 20", group = G1, inline = "m")
bool showEma50 = input.bool(false, "EMA 50", group = G1, inline = "m")
int maxZones = input.int(40, "Хранить последних зон", minval = 1, maxval = 150, group = G1)
if slowLen <= fastLen
    runtime.error("Медленная EMA должна быть больше быстрой.")

float lsrc = emaLog ? math.log(close) : close
float emaF = ta.ema(lsrc, fastLen)
float emaS = ta.ema(lsrc, slowLen)
float emaFP = emaLog ? math.exp(emaF) : emaF
float emaSP = emaLog ? math.exp(emaS) : emaS
float sma200 = ta.sma(close, 200)
float ema20 = ta.ema(close, 20)
float ema50 = ta.ema(close, 50)

// Внутренняя скорость и ускорение (не рисуются): те же формулы, что в «TW Спидометр».
float spSrc = 100.0 * math.log(close)
float speed = ta.ema(spSrc, fastLen) - ta.ema(spSrc, slowLen)
float accel = speed - ta.ema(speed, 5)

// Слепая зона: состояние «на ходу» через var, без циклов по истории.
var int bzReg = 0
var float bzExt = na
var int bzExtBar = na
var float bzOpp = na
float emaDiff = emaF - emaS
int bzNew = emaDiff > 0 ? 1 : emaDiff < 0 ? -1 : bzReg
if bzReg == 1
    if high > bzExt
        bzExt := high
        bzExtBar := bar_index
        bzOpp := low
    else
        bzOpp := math.min(bzOpp, low)
else if bzReg == -1
    if low < bzExt
        bzExt := low
        bzExtBar := bar_index
        bzOpp := high
    else
        bzOpp := math.max(bzOpp, high)

bool emaCross = false
int zReg = 0
int zLeft = na
float zExt = na
float zOpp = na
if bzNew != bzReg and bzNew != 0
    if bzReg != 0
        emaCross := true
        zReg := bzReg
        zLeft := bzExtBar
        zExt := bzExt
        zOpp := bzOpp
    bzExt := bzNew == 1 ? high : low
    bzExtBar := bar_index
    bzOpp := bzNew == 1 ? low : high
bzReg := bzNew

var array<box> bzBoxes = array.new<box>()
if m1On and showZones and emaCross
    color zc = zReg == 1 ? C_UP : C_DN
    bzBoxes.push(box.new(zLeft, zReg == 1 ? zExt : zOpp, bar_index, zReg == 1 ? zOpp : zExt,
         border_color = color.new(zc, 50), bgcolor = color.new(zc, 88),
         text = dl >= 1 ? "слепая зона " + str.tostring(bar_index - zLeft) + " бар." : "слепая зона",
         text_size = size.tiny, text_color = color.new(C_TX, 30), text_valign = text.align_top, text_halign = text.align_left))
    if bzBoxes.size() > maxZones
        bzBoxes.shift().delete()

bool inLiveBz = bzReg != 0 and bar_index > bzExtBar
bgcolor(m1On and showLiveBz and inLiveBz ? color.new(bzReg == 1 ? C_UP : C_DN, 93) : na, title = "Внутри живой слепой зоны")

pF = plot(m1On ? emaFP : na, "EMA быстрая", color = C_UP, linewidth = 1)
pS = plot(m1On ? emaSP : na, "EMA медленная", color = C_DN, linewidth = 2)
fill(pF, pS, color = m1On and showFill ? (emaDiff > 0 ? color.new(C_UP, 85) : color.new(C_DN, 85)) : na, title = "Заливка EMA")
plot(m1On and showSma200 ? sma200 : na, "SMA 200", color = color.new(C_TX, 25), linewidth = 2)
plot(m1On and showEma20 ? ema20 : na, "EMA 20", color = color.new(C_OK, 0), linewidth = 1)
plot(m1On and showEma50 ? ema50 : na, "EMA 50", color = color.new(C_ACC, 0), linewidth = 1)

// ============================================================================
// M2. ZigZag и точки разворота
// Свинги хранятся в массивах и чередуются (два максимума подряд — остаётся больший,
// два минимума — меньший). Для каждой ноги копятся пик скорости, объём и число баров
// по полуоткрытому отрезку (предыдущий свинг; свинг]. В режиме пивотов накопление идёт
// с лагом L баров (бар i - L), поэтому к моменту подтверждения пивота нога посчитана ровно
// до его бара — без циклов по истории.
// ============================================================================
const string G2 = "2. ZigZag и точки разворота"
const string Z_PIV = "Пивоты (L баров)"
const string Z_PCT = "Процентный ZigZag"
bool m2Show = input.bool(true, "Показывать ZigZag", group = G2,
     tooltip = "Свинги считаются всегда — на них опираются модули 4 и 6-10. Переключатель отвечает только за отрисовку.")
string zzMode = input.string(Z_PIV, "Режим", options = [Z_PIV, Z_PCT], group = G2,
     tooltip = "Пивоты: ta.pivothigh/ta.pivotlow длины L — свинг подтверждается через L баров. Процентный: разворот, когда цена ушла от экстремума на заданный %.")
int zzLen = input.int(10, "Длина пивота L", minval = 2, maxval = 50, group = G2)
float zzPct = input.float(5.0, "Порог процентного ZigZag, %", minval = 0.1, maxval = 50.0, step = 0.5, group = G2)
int minorLen = input.int(3, "Малые пивоты (первый триггер)", minval = 1, maxval = 10, group = G2,
     tooltip = "Малые пивоты используются для «первого триггера» — последнего локального экстремума внутри коррекции.")
bool legInfoIn = input.bool(false, "Информация о ногах: %, бары, объём/бар", group = G2,
     tooltip = "В детализации «Всё» включается автоматически.")
int maxSwDraw = input.int(30, "Рисовать последних свингов", minval = 5, maxval = 100, group = G2)

bool isPiv = zzMode == Z_PIV
int L = zzLen
bool legInfo = legInfoIn or dl == 2

// ta.* — на глобальном уровне, на каждом баре
float phMaj = ta.pivothigh(high, L, L)
float plMaj = ta.pivotlow(low, L, L)
float phMin = ta.pivothigh(high, minorLen, minorLen)
float plMin = ta.pivotlow(low, minorLen, minorLen)
float spdHiL = ta.highest(speed, L)
float spdLoL = ta.lowest(speed, L)
float volZ = nz(volume)
float volSumL = math.sum(volZ, L)
float loL = ta.lowest(low, L)
int loLOff = ta.lowestbars(low, L)
float hiL = ta.highest(high, L)
int hiLOff = ta.highestbars(high, L)

var float cumPV = 0.0
var float cumV = 0.0
cumPV += hlc3 * volZ
cumV += volZ
var bool hasVol = false
if volZ > 0
    hasVol := true

// свинги и ноги (нога i закончилась в свинге i)
const int MAX_SW = 60
var array<int> swBar = array.new<int>()
var array<float> swPx = array.new<float>()
var array<int> swDir = array.new<int>()
var array<float> swSpd = array.new<float>()
var array<float> swPV0 = array.new<float>()
var array<float> swV0 = array.new<float>()
var array<float> lgMx = array.new<float>()
var array<float> lgMn = array.new<float>()
var array<float> lgVol = array.new<float>()
var array<int> lgN = array.new<int>()

f_mx(float a, float b) =>
    na(a) ? b : na(b) ? a : math.max(a, b)

f_mn(float a, float b) =>
    na(a) ? b : na(b) ? a : math.min(a, b)

f_swPush(int b, float p, int d, float sp, float pv0, float v0, float mx, float mn, float vl, int n) =>
    swBar.push(b)
    swPx.push(p)
    swDir.push(d)
    swSpd.push(sp)
    swPV0.push(pv0)
    swV0.push(v0)
    lgMx.push(mx)
    lgMn.push(mn)
    lgVol.push(vl)
    lgN.push(n)
    if swBar.size() > MAX_SW
        swBar.shift()
        swPx.shift()
        swDir.shift()
        swSpd.shift()
        swPV0.shift()
        swV0.shift()
        lgMx.shift()
        lgMn.shift()
        lgVol.shift()
        lgN.shift()

f_swSetLast(int b, float p, float sp, float pv0, float v0, float mx, float mn, float vl, int n) =>
    int k = swBar.size() - 1
    swBar.set(k, b)
    swPx.set(k, p)
    swSpd.set(k, sp)
    swPV0.set(k, pv0)
    swV0.set(k, v0)
    lgMx.set(k, mx)
    lgMn.set(k, mn)
    lgVol.set(k, vl)
    lgN.set(k, n)

// --- отрисовка свингов: линия от предыдущего свинга и подпись; при замене — set_*
var array<line> zzLines = array.new<line>()
var array<label> zzLabels = array.new<label>()

f_swText(int k) =>
    string t = str.tostring(swPx.get(k), format.mintick)
    if legInfo and k > 0
        float p0 = swPx.get(k - 1)
        int n = lgN.get(k)
        float va = n > 0 and hasVol ? lgVol.get(k) / n : na
        t += "\n" + (swPx.get(k) >= p0 ? "+" : "") + str.tostring((swPx.get(k) / p0 - 1) * 100, "0.0") + " %, " +
             str.tostring(swBar.get(k) - swBar.get(k - 1)) + " бар." + (na(va) ? "" : ", об./бар " + str.tostring(va, format.volume))
    t

f_drawSwing(bool replaced) =>
    if m2Show
        int k = swBar.size() - 1
        int d = swDir.get(k)
        string st = d == 1 ? label.style_label_down : label.style_label_up
        if replaced and zzLabels.size() > 0
            label lb = zzLabels.last()
            lb.set_xy(swBar.get(k), swPx.get(k))
            lb.set_text(dl >= 1 ? f_swText(k) : "")
            if k > 0 and zzLines.size() > 0
                zzLines.last().set_xy2(swBar.get(k), swPx.get(k))
        else
            if k > 0
                zzLines.push(line.new(swBar.get(k - 1), swPx.get(k - 1), swBar.get(k), swPx.get(k), color = C_ACC, width = 2))
            zzLabels.push(label.new(swBar.get(k), swPx.get(k), dl >= 1 ? f_swText(k) : "", style = st,
                 color = color.new(C_ACC, dl >= 1 ? 80 : 100), textcolor = C_TX, size = size.tiny))
            if zzLines.size() > maxSwDraw
                zzLines.shift().delete()
            if zzLabels.size() > maxSwDraw
                zzLabels.shift().delete()

// накопитель текущей ноги и текущий (незавершённый) экстремум против последнего свинга
var float aMx = na
var float aMn = na
var float aVol = 0.0
var int aN = 0
var float rnPx = na
var int rnBar = na
var float rnSpd = na
var float rnPV0 = na
var float rnV0 = na
bool newSwing = false

if isPiv
    // нога копится с лагом L баров
    if bar_index >= L
        aMx := f_mx(aMx, speed[L])
        aMn := f_mn(aMn, speed[L])
        aVol += volZ[L]
        aN += 1
    // текущий экстремум обновляется текущим баром
    if swBar.size() > 0 and not na(rnPx)
        if swDir.last() == 1 and low < rnPx
            rnPx := low
            rnBar := bar_index
            rnSpd := speed
            rnPV0 := nz(cumPV[1])
            rnV0 := nz(cumV[1])
        else if swDir.last() == -1 and high > rnPx
            rnPx := high
            rnBar := bar_index
            rnSpd := speed
            rnPV0 := nz(cumPV[1])
            rnV0 := nz(cumV[1])
    int firstD = swDir.size() > 0 and swDir.last() == 1 ? -1 : 1
    for k = 0 to 1
        int d = k == 0 ? firstD : -firstD
        float pv = d == 1 ? phMaj : plMaj
        if not na(pv)
            bool same = swDir.size() > 0 and swDir.last() == d
            bool doIt = not same or (d == 1 ? pv > swPx.last() : pv < swPx.last())
            if doIt
                if same
                    int kk = swBar.size() - 1
                    f_swSetLast(bar_index - L, pv, speed[L], nz(cumPV[L + 1]), nz(cumV[L + 1]),
                         f_mx(lgMx.get(kk), aMx), f_mn(lgMn.get(kk), aMn), lgVol.get(kk) + aVol, lgN.get(kk) + aN)
                else
                    f_swPush(bar_index - L, pv, d, speed[L], nz(cumPV[L + 1]), nz(cumV[L + 1]), aMx, aMn, aVol, aN)
                f_drawSwing(same)
                aMx := na
                aMn := na
                aVol := 0.0
                aN := 0
                newSwing := true
                // экстремум против нового свинга на отрезке (пивот; текущий бар]
                int off = d == 1 ? loLOff : hiLOff
                rnPx := d == 1 ? loL : hiL
                rnBar := bar_index + off
                rnSpd := speed[-off]
                rnPV0 := nz(cumPV[-off + 1])
                rnV0 := nz(cumV[-off + 1])

// процентный ZigZag: кандидат-экстремум, «снимок» ноги на баре кандидата и нога после кандидата
var int zDir = 1
var float snMx = na
var float snMn = na
var float snVol = 0.0
var int snN = 0
var float siMx = na
var float siMn = na
var float siVol = 0.0
var int siN = 0
if not isPiv
    aMx := f_mx(aMx, speed)
    aMn := f_mn(aMn, speed)
    aVol += volZ
    aN += 1
    siMx := f_mx(siMx, speed)
    siMn := f_mn(siMn, speed)
    siVol += volZ
    siN += 1
    float thr = zzPct / 100.0
    bool newCand = false
    bool confirm = false
    if na(rnPx)
        newCand := true
    else if zDir == 1
        if high > rnPx
            newCand := true
        else if low <= rnPx * (1 - thr)
            confirm := true
    else
        if low < rnPx
            newCand := true
        else if high >= rnPx * (1 + thr)
            confirm := true
    if confirm
        f_swPush(rnBar, rnPx, zDir, rnSpd, rnPV0, rnV0, snMx, snMn, snVol, snN)
        f_drawSwing(false)
        newSwing := true
        aMx := siMx
        aMn := siMn
        aVol := siVol
        aN := siN
        zDir := -zDir
        newCand := true
    if newCand
        rnPx := zDir == 1 ? high : low
        rnBar := bar_index
        rnSpd := speed
        rnPV0 := nz(cumPV[1])
        rnV0 := nz(cumV[1])
        snMx := aMx
        snMn := aMn
        snVol := aVol
        snN := aN
        siMx := na
        siMn := na
        siVol := 0.0
        siN := 0

bool hasRun = swBar.size() > 0 and not na(rnPx)
// статистика текущей (незавершённой) ноги (последний свинг; сейчас]
float rlMx = isPiv ? f_mx(aMx, spdHiL) : aMx
float rlMn = isPiv ? f_mn(aMn, spdLoL) : aMn
float rlVol = isPiv ? aVol + nz(volSumL) : aVol
int rlN = isPiv ? aN + L : aN

// малые пивоты (для «первого триггера»)
const int MAX_MINOR = 40
var array<int> mhBar = array.new<int>()
var array<float> mhPx = array.new<float>()
var array<int> mlBar = array.new<int>()
var array<float> mlPx = array.new<float>()
if not na(phMin)
    mhBar.push(bar_index - minorLen)
    mhPx.push(phMin)
    if mhBar.size() > MAX_MINOR
        mhBar.shift()
        mhPx.shift()
if not na(plMin)
    mlBar.push(bar_index - minorLen)
    mlPx.push(plMin)
    if mlBar.size() > MAX_MINOR
        mlBar.shift()
        mlPx.shift()

// последний незавершённый отрезок — пунктиром, с пометкой о возможной перерисовке
var line zzLive = na
var label zzLiveLbl = na
if barstate.islast and m2Show and hasRun
    int kL = swBar.size() - 1
    if na(zzLive)
        zzLive := line.new(swBar.get(kL), swPx.get(kL), rnBar, rnPx, color = color.new(C_ACC, 30), width = 1, style = line.style_dashed)
        zzLiveLbl := label.new(rnBar, rnPx, "", color = color.new(C_ACC, 100), textcolor = C_MUTED, size = size.tiny)
    zzLive.set_xy1(swBar.get(kL), swPx.get(kL))
    zzLive.set_xy2(rnBar, rnPx)
    zzLiveLbl.set_xy(rnBar, rnPx)
    zzLiveLbl.set_style(swDir.get(kL) == 1 ? label.style_label_up : label.style_label_down)
    zzLiveLbl.set_text(dl >= 1 ? "не подтверждён — может перерисоваться" : "?")

// ============================================================================
// Точки, заданные датами (input.time): бар точки — первый бар, у которого время закрытия
// позже даты (свеча, содержащая дату, или первая после разрыва). 0 = точка не задана.
// ============================================================================
type TPt
    int t = 0
    bool done = false
    int bar = na
    float hi = na
    float lo = na
    float cl = na
    int tm = na
    float sp = na
    float pv0 = na
    float v0 = na

f_newPts(array<int> ts) =>
    array<TPt> a = array.new<TPt>()
    for t in ts
        a.push(TPt.new(t))
    a

// фиксированный цикл по заданным точкам (не по истории)
f_detect(array<TPt> pts) =>
    int tcN = na(time_close) ? time : time_close
    for p in pts
        if p.t > 0 and not p.done and tcN > p.t
            p.done := true
            p.bar := bar_index
            p.hi := high
            p.lo := low
            p.cl := close
            p.tm := time
            p.sp := speed
            p.pv0 := nz(cumPV[1])
            p.v0 := nz(cumV[1])

// ============================================================================
// M3. Разметка волн Эллиотта (ручная) и проверка жёстких правил
// Авто-разметки нет: надёжной автоматической разметки волн не существует.
// ============================================================================
const string G3 = "3. Разметка волн (ручная)"
const string W_IMP = "Импульс 0-1-2-3-4-5"
const string W_DIA = "Диагональ 0-1-2-3-4-5"
const string W_ZZ = "Зигзаг 0-A-B-C"
const string W_FL = "Плоскость 0-A-B-C"
const string N_CIRC = "①②③ / ⒶⒷⒸ"
const string N_PAR = "(1)(2)(3) / (A)(B)(C)"
const string N_PLAIN = "1 2 3 / A B C"
const string N_ROMAN = "i ii iii / a b c"
bool m3On = input.bool(true, "Включить разметку", group = G3,
     tooltip = "Задайте даты точек. Цена точки — экстремум бара по направлению (high для вершин, low для впадин). Пока точки 0 и 1 не заданы, модуль ничего не рисует.")
string wKind = input.string(W_IMP, "Тип", options = [W_IMP, W_DIA, W_ZZ, W_FL], group = G3)
// 0 = не задано. Пример даты: 1789430400000 = 15.09.2026 00:00 UTC (только число, не timestamp()).
int wt0 = input.time(0, "Точка 0 (начало)", confirm = false, group = G3)
int wt1 = input.time(0, "Точка 1 / A", confirm = false, group = G3)
int wt2 = input.time(0, "Точка 2 / B", confirm = false, group = G3)
int wt3 = input.time(0, "Точка 3 / C", confirm = false, group = G3)
int wt4 = input.time(0, "Точка 4", confirm = false, group = G3)
int wt5 = input.time(0, "Точка 5", confirm = false, group = G3)
string wNote = input.string(N_CIRC, "Нотация степени", options = [N_CIRC, N_PAR, N_PLAIN, N_ROMAN], group = G3, inline = "deg")
color wCol = input.color(#CC79A7, "цвет", group = G3, inline = "deg")

var array<TPt> wPts = f_newPts(array.from(wt0, wt1, wt2, wt3, wt4, wt5))
f_detect(wPts)

bool wCorr = wKind == W_ZZ or wKind == W_FL

f_note(string sty, int i, bool corr) =>
    string r = ""
    if corr
        int k = math.min(i, 3)
        r := sty == N_CIRC ? array.from("⓪", "Ⓐ", "Ⓑ", "Ⓒ").get(k) : sty == N_PAR ? array.from("(0)", "(A)", "(B)", "(C)").get(k) :
             sty == N_PLAIN ? array.from("0", "A", "B", "C").get(k) : array.from("0", "a", "b", "c").get(k)
    else
        int k = math.min(i, 5)
        r := sty == N_CIRC ? array.from("⓪", "①", "②", "③", "④", "⑤").get(k) : sty == N_PAR ? array.from("(0)", "(1)", "(2)", "(3)", "(4)", "(5)").get(k) :
             sty == N_PLAIN ? array.from("0", "1", "2", "3", "4", "5").get(k) : array.from("0", "i", "ii", "iii", "iv", "v").get(k)
    r

// результат проверки — для таблицы разметки
var array<string> rName = array.new<string>()
var array<int> rState = array.new<int>()        // 1 ✓, 0 ✗, -1 —
var array<string> rNote = array.new<string>()
var array<string> ratTxt = array.new<string>()
var array<line> wLines = array.new<line>()
var array<label> wLabels = array.new<label>()
int wN = 0          // число заданных подряд точек (с 0)
int wD = 0          // направление разметки
array<float> wPx = array.new<float>()
array<int> wBar = array.new<int>()

f_rule(string name, bool cond, string note) =>
    rName.push(name)
    rState.push(cond ? 1 : 0)
    rNote.push(note)

f_ruleNA(string name, string note) =>
    rName.push(name)
    rState.push(-1)
    rNote.push(note)

f_llen(float a, float b) =>
    math.abs(math.log(b) - math.log(a))

if barstate.islast and m3On
    rName.clear()
    rState.clear()
    rNote.clear()
    ratTxt.clear()
    int maxP = wCorr ? 4 : 6
    bool ordered = true
    for i = 0 to maxP - 1
        TPt p = wPts.get(i)
        if p.t > 0 and p.done and wN == i
            if i > 0 and p.bar <= wPts.get(i - 1).bar
                ordered := false
            else
                wN += 1
    if wN >= 2 and ordered
        TPt p0 = wPts.get(0)
        TPt pLast = wPts.get(wCorr ? 1 : wN - 1)
        wD := pLast.cl > p0.cl ? 1 : -1
        for i = 0 to wN - 1
            TPt p = wPts.get(i)
            bool upPt = (i % 2 == 1) == (wD == 1)
            wPx.push(upPt ? p.hi : p.lo)
            wBar.push(p.bar)
        // рисование: пулы линий и подписей создаются один раз, дальше — set_*
        if wLines.size() == 0
            for i = 0 to 4
                wLines.push(line.new(na, na, na, na, color = wCol, width = 2))
            for i = 0 to 5
                wLabels.push(label.new(na, na, "", color = color.new(wCol, 100), textcolor = wCol, size = size.normal))
        for i = 0 to 5
            label lb = wLabels.get(i)
            if i < wN
                bool upPt = (i % 2 == 1) == (wD == 1)
                lb.set_xy(wBar.get(i), wPx.get(i))
                lb.set_text(f_note(wNote, i, wCorr))
                lb.set_style(upPt ? label.style_label_down : label.style_label_up)
                lb.set_textcolor(wCol)
            else
                lb.set_text("")
        for i = 0 to 4
            line ln = wLines.get(i)
            if i < wN - 1
                ln.set_xy1(wBar.get(i), wPx.get(i))
                ln.set_xy2(wBar.get(i + 1), wPx.get(i + 1))
                ln.set_color(wCol)
            else
                ln.set_color(color.new(wCol, 100))
        // жёсткие правила (для нисходящей разметки сравнения зеркальны: множитель s)
        int s = wD
        array<float> P = wPx
        array<float> Ln = array.new<float>()
        for i = 0 to wN - 2
            Ln.push(f_llen(P.get(i), P.get(i + 1)))
        if not wCorr
            if wN >= 3
                f_rule("2 не за началом 1", s * (P.get(2) - P.get(0)) > 0, s == 1 ? "минимум 2 выше начала 1" : "максимум 2 ниже начала 1")
            if wKind == W_IMP
                if wN >= 6
                    f_rule("3 не самая короткая", not (Ln.get(2) < Ln.get(0) and Ln.get(2) < Ln.get(4)), "длины 1, 3, 5 в лог-шкале")
                else
                    f_ruleNA("3 не самая короткая", "нужна точка 5")
                if wN >= 5
                    f_rule("4 не заходит в зону 1", s * (P.get(4) - P.get(1)) > 0, "4 не перекрывает вершину 1")
            else
                if wN >= 5
                    f_rule("4 заходит в зону 1", s * (P.get(4) - P.get(1)) < 0, "у диагонали перекрытие обязательно")
                    f_rule("4 не за вершиной 2", s * (P.get(4) - P.get(2)) > 0, "4 не уходит за конец 2")
                if wN >= 6
                    bool contr = Ln.get(0) > Ln.get(2) and Ln.get(2) > Ln.get(4) and Ln.get(1) > Ln.get(3)
                    bool expd = Ln.get(0) < Ln.get(2) and Ln.get(2) < Ln.get(4) and Ln.get(1) < Ln.get(3)
                    f_rule("форма 1>3>5, 2>4 или 1<3<5, 2<4", contr or expd, contr ? "сужающаяся" : expd ? "расширяющаяся" : "не сужается и не расширяется")
            if wN >= 4
                ratTxt.push("3/1 = " + str.tostring(Ln.get(2) / Ln.get(0), "0.00"))
                ratTxt.push("глубина 2 = " + str.tostring(Ln.get(1) / Ln.get(0), "0.00"))
            if wN >= 5
                ratTxt.push("глубина 4 = " + str.tostring(Ln.get(3) / Ln.get(2), "0.00"))
            if wN >= 6
                ratTxt.push("5/1 = " + str.tostring(Ln.get(4) / Ln.get(0), "0.00"))
                ratTxt.push("5/3 = " + str.tostring(Ln.get(4) / Ln.get(2), "0.00"))
        else
            if wKind == W_ZZ
                if wN >= 3
                    f_rule("B не за началом A", s * (P.get(2) - P.get(0)) > 0, "откат B меньше 100 % A")
                if wN >= 4
                    bool cOk = s * (P.get(3) - P.get(1)) > 0
                    f_rule("C за концом A", cOk, cOk ? "C обновил конец A" : "усечение: C не дошёл до конца A")
            else
                if wN >= 3
                    float rb = Ln.get(1) / Ln.get(0)
                    f_rule("B >= 90 % A", rb >= 0.9, "B = " + str.tostring(rb * 100, "0") + " % A")
                    if wN >= 4
                        bool cBeyond = s * (P.get(3) - P.get(1)) > 0
                        ratTxt.push("тип: " + (rb <= 1.05 ? "регулярная" : cBeyond ? "расширенная" : "бегущая"))
            if wN >= 3
                ratTxt.push("B/A = " + str.tostring(Ln.get(1) / Ln.get(0), "0.00"))
            if wN >= 4
                ratTxt.push("C/A = " + str.tostring(Ln.get(2) / Ln.get(0), "0.00"))
    else if wLines.size() > 0
        for ln in wLines
            ln.set_color(color.new(wCol, 100))
        for lb in wLabels
            lb.set_text("")

// ============================================================================
// M4. Последний импульс и коррекция A -> B -> C
// Авто по ZigZag: если последняя нога откатила меньше 100 % предыдущей — A, B, C = три
// последних свинга (коррекция завершена). Иначе A, B = два последних свинга, C — текущий
// экстремум коррекции (не подтверждён). Направление — по B относительно A.
// ============================================================================
const string G4 = "4. Последний импульс и коррекция A-B-C"
const string S_AUTO = "Авто по ZigZag"
const string S_MAN = "Вручную по датам"
bool m4On = input.bool(true, "Показывать уровни A-B-C", group = G4)
string abcSrc = input.string(S_AUTO, "Источник A, B, C", options = [S_AUTO, S_MAN], group = G4,
     tooltip = "Авто — по свингам модуля 2. Вручную — по датам ниже (цена — экстремум бара по направлению).")
int tA = input.time(0, "A — начало волны 1", confirm = false, group = G4)
int tB = input.time(0, "B — конец волны 1", confirm = false, group = G4)
int tC = input.time(0, "C — конец коррекции", confirm = false, group = G4)
bool fibLog = input.bool(true, "Зоны и цели в лог-шкале", group = G4,
     tooltip = "Откат и расширение считаются по логарифму цены (сравнимо на любом уровне цены). Выключите для линейных.")
bool showFibZones = input.bool(true, "Зоны коррекции 38.2 / 50 / 61.8 / 78.6 %", group = G4)
bool showTargets = input.bool(true, "Цели волны 3: 1.0 / 1.618 / 2.618 x (B - A) от C", group = G4)
bool linTargets = input.bool(false, "Дополнительно линейные цели", group = G4)

f_fw(float x) =>
    fibLog ? math.log(x) : x

f_iv(float y) =>
    fibLog ? math.exp(y) : y

f_ret(float a, float b, float c) =>
    float fa = f_fw(a)
    float fb = f_fw(b)
    fb == fa ? na : (fb - f_fw(c)) / (fb - fa)

var array<TPt> abcPts = f_newPts(array.from(tA, tB, tC))
f_detect(abcPts)
TPt mA = abcPts.get(0)
TPt mB = abcPts.get(1)
TPt mC = abcPts.get(2)

// ручные ноги (A; B] и (B; C]
var float mABmx = na
var float mABmn = na
var float mABvol = 0.0
var int mABn = 0
var float mBCmx = na
var float mBCmn = na
var float mBCvol = 0.0
var int mBCn = 0
if mA.done and bar_index > mA.bar and (not mB.done or mB.bar == bar_index)
    mABmx := f_mx(mABmx, speed)
    mABmn := f_mn(mABmn, speed)
    mABvol += volZ
    mABn += 1
if mB.done and bar_index > mB.bar and (not mC.done or mC.bar == bar_index)
    mBCmx := f_mx(mBCmx, speed)
    mBCmn := f_mn(mBCmn, speed)
    mBCvol += volZ
    mBCn += 1

// --- структура на текущем баре
int sCand = 0           // 0 — нет, 1 — C текущий (не подтверждён), 2 — C подтверждён
int aBar = na
float aPx = na
float aPV0 = na
float aV0 = na
int bBar = na
float bPx = na
int cBar = na
float cPx = na
float cSpd = na
float cPV0 = na
float cV0 = na
float abMx = na
float abMn = na
float abVol = na
int abN = 0
float bcMx = na
float bcMn = na
float bcVol = na
int bcN = 0
int nSw = swBar.size()
if abcSrc == S_AUTO
    if nSw >= 3
        float r3 = f_ret(swPx.get(nSw - 3), swPx.get(nSw - 2), swPx.get(nSw - 1))
        if not na(r3) and r3 > 0 and r3 < 1
            sCand := 2
            aBar := swBar.get(nSw - 3)
            aPx := swPx.get(nSw - 3)
            aPV0 := swPV0.get(nSw - 3)
            aV0 := swV0.get(nSw - 3)
            bBar := swBar.get(nSw - 2)
            bPx := swPx.get(nSw - 2)
            cBar := swBar.get(nSw - 1)
            cPx := swPx.get(nSw - 1)
            cSpd := swSpd.get(nSw - 1)
            cPV0 := swPV0.get(nSw - 1)
            cV0 := swV0.get(nSw - 1)
            abMx := lgMx.get(nSw - 2)
            abMn := lgMn.get(nSw - 2)
            abVol := lgVol.get(nSw - 2)
            abN := lgN.get(nSw - 2)
            bcMx := lgMx.get(nSw - 1)
            bcMn := lgMn.get(nSw - 1)
            bcVol := lgVol.get(nSw - 1)
            bcN := lgN.get(nSw - 1)
    if sCand == 0 and nSw >= 2 and hasRun
        sCand := 1
        aBar := swBar.get(nSw - 2)
        aPx := swPx.get(nSw - 2)
        aPV0 := swPV0.get(nSw - 2)
        aV0 := swV0.get(nSw - 2)
        bBar := swBar.get(nSw - 1)
        bPx := swPx.get(nSw - 1)
        cBar := rnBar
        cPx := rnPx
        cSpd := rnSpd
        cPV0 := rnPV0
        cV0 := rnV0
        abMx := lgMx.get(nSw - 1)
        abMn := lgMn.get(nSw - 1)
        abVol := lgVol.get(nSw - 1)
        abN := lgN.get(nSw - 1)
        bcMx := rlMx
        bcMn := rlMn
        bcVol := rlVol
        bcN := rlN
else if mA.done and mB.done and mC.done and mA.bar < mB.bar and mB.bar < mC.bar
    int dm = mB.cl > mA.cl ? 1 : -1
    sCand := 2
    aBar := mA.bar
    aPx := dm == 1 ? mA.lo : mA.hi
    aPV0 := mA.pv0
    aV0 := mA.v0
    bBar := mB.bar
    bPx := dm == 1 ? mB.hi : mB.lo
    cBar := mC.bar
    cPx := dm == 1 ? mC.lo : mC.hi
    cSpd := mC.sp
    cPV0 := mC.pv0
    cV0 := mC.v0
    abMx := mABmx
    abMn := mABmn
    abVol := mABvol
    abN := mABn
    bcMx := mBCmx
    bcMn := mBCmn
    bcVol := mBCvol
    bcN := mBCn

bool hasStruct = sCand > 0
int dS = hasStruct ? (bPx > aPx ? 1 : -1) : 0
float retr = hasStruct ? f_ret(aPx, bPx, cPx) : na

// «первый триггер»: последний малый экстремум внутри коррекции (между B и C), против коррекции
float trigPx = na
int trigBar = na
if hasStruct
    int nm = dS == 1 ? mhBar.size() : mlBar.size()
    if nm > 0
        for i = nm - 1 to 0
            int mb = dS == 1 ? mhBar.get(i) : mlBar.get(i)
            if mb < cBar and mb > bBar
                trigBar := mb
                trigPx := dS == 1 ? mhPx.get(i) : mlPx.get(i)
                break

f_fib(float r) =>
    f_iv(f_fw(bPx) - r * (f_fw(bPx) - f_fw(aPx)))

f_tgt(float k, bool lg) =>
    lg ? math.exp(math.log(cPx) + k * (math.log(bPx) - math.log(aPx))) : cPx + k * (bPx - aPx)

float tg1 = hasStruct ? f_tgt(1.0, fibLog) : na
float tg2 = hasStruct ? f_tgt(1.618, fibLog) : na
float tg3 = hasStruct ? f_tgt(2.618, fibLog) : na

// --- отрисовка уровней: постоянный пул линий, подписей и полос; на последнем баре — только set_*
float atrGap = ta.atr(14)
const int LV_N = 16
var array<line> lvLines = array.new<line>()
var array<label> lvLabels = array.new<label>()
var array<box> fibBoxes = array.new<box>()

type TLv
    float y
    string t
    color c
    int x
    string st

f_lv(array<TLv> a, float y, string t, color c, int x, string st) =>
    a.push(TLv.new(y, t + "  " + str.tostring(y, format.mintick), c, x, st))

// раздвигает подписи по вертикали: сортировка по цене, минимальный зазор gap
f_spread(array<float> ys, float gap) =>
    array<float> out = array.copy(ys)
    array<int> idx = array.sort_indices(ys, order.ascending)
    float prev = na
    for k in idx
        float y = ys.get(k)
        if not na(y)
            float yy = na(prev) ? y : math.max(y, prev + gap)
            out.set(k, yy)
            prev := yy
    out

if barstate.islast
    if lvLines.size() == 0
        for i = 0 to LV_N - 1
            lvLines.push(line.new(na, na, na, na, width = 1))
            lvLabels.push(label.new(na, na, "", style = label.style_label_left, size = size.small))
        for i = 0 to 2
            fibBoxes.push(box.new(na, na, na, na, border_color = color.new(C_UP, 100)))
    array<TLv> lv = array.new<TLv>()
    bool draw = m4On and hasStruct
    if draw
        f_lv(lv, aPx, "отмена: начало волны 1 (A)", C_DN, aBar, line.style_solid)
        f_lv(lv, bPx, "конец волны 1 (B)", C_MUTED, bBar, line.style_dotted)
        f_lv(lv, cPx, sCand == 1 ? "стоп идеи (C, не подтверждён)" : "стоп идеи (C)", C_DN, cBar, line.style_dashed)
        if not na(trigPx)
            f_lv(lv, trigPx, "первый триггер", C_UP, trigBar, line.style_dashed)
        if showFibZones and dl >= 1
            for r in array.from(0.382, 0.5, 0.618, 0.786)
                f_lv(lv, f_fib(r), str.tostring(r * 100, "0.0") + " %", C_MUTED, bBar, line.style_dotted)
        if showTargets
            f_lv(lv, tg1, "цель 1.0", C_OK, cBar, line.style_solid)
            if dl >= 1
                f_lv(lv, tg2, "цель 1.618", C_OK, cBar, line.style_solid)
            if dl >= 2
                f_lv(lv, tg3, "цель 2.618", C_OK, cBar, line.style_solid)
            if linTargets
                f_lv(lv, f_tgt(1.0, false), "цель 1.0 (лин.)", C_OK, cBar, line.style_dotted)
                if dl >= 1
                    f_lv(lv, f_tgt(1.618, false), "цель 1.618 (лин.)", C_OK, cBar, line.style_dotted)
    array<float> lvY = array.new<float>()
    for v in lv
        lvY.push(v.y)
    array<float> ly = f_spread(lvY, nz(atrGap) * 0.7)
    int xR = bar_index + lblOffset
    for i = 0 to LV_N - 1
        line ln = lvLines.get(i)
        label lb = lvLabels.get(i)
        if i < lv.size()
            TLv v = lv.get(i)
            ln.set_xy1(v.x, v.y)
            ln.set_xy2(xR, v.y)
            ln.set_color(v.c)
            ln.set_style(v.st)
            lb.set_xy(xR, ly.get(i))
            lb.set_text(v.t)
            lb.set_textcolor(v.c)
            lb.set_color(color.new(C_BG, 15))
        else
            ln.set_color(color.new(C_MUTED, 100))
            lb.set_text("")
            lb.set_color(color.new(C_BG, 100))
    // полосы коррекции; ключевая 50-61.8 % — насыщеннее
    for i = 0 to 2
        box bx = fibBoxes.get(i)
        if draw and showFibZones
            float r1 = array.from(0.382, 0.5, 0.618).get(i)
            float r2 = array.from(0.5, 0.618, 0.786).get(i)
            bx.set_lefttop(bBar, math.max(f_fib(r1), f_fib(r2)))
            bx.set_rightbottom(xR, math.min(f_fib(r1), f_fib(r2)))
            bx.set_bgcolor(color.new(dS == 1 ? C_UP : C_DN, i == 1 ? 80 : 93))
            bx.set_text(i == 1 and dl >= 1 ? "ключевая зона 50-61.8 %" : "")
            bx.set_text_size(size.tiny)
            bx.set_text_color(C_MUTED)
            bx.set_text_halign(text.align_left)
        else
            bx.set_bgcolor(color.new(C_UP, 100))
            bx.set_text("")

// ============================================================================
// M5. Каналы Эллиотта (по ручной разметке M3)
// ============================================================================
const string G5 = "5. Каналы (по ручной разметке)"
bool m5Ch4 = input.bool(true, "Канал волны 4: линия 2-4 и параллель через 3", group = G5,
     tooltip = "Параллель через 3 — ориентир для волны 5. Нужны точки 0-4 разметки импульса или диагонали.")
bool m5Via1 = input.bool(false, "Параллель через 1 (при растянутой 3)", group = G5,
     tooltip = "В детализации «Всё» включается автоматически.")
bool m5Base = input.bool(true, "«Норма о каналах»: линия 1-3, параллель через 2", group = G5,
     tooltip = "Средняя линия канала 1-3 — минимальная цель волны 4, удвоенный канал — граница. Нужны точки 0-3.")

var array<line> chLines = array.new<line>()
var array<label> chLabels = array.new<label>()
if barstate.islast
    if chLines.size() == 0
        for i = 0 to 6
            chLines.push(line.new(na, na, na, na, extend = extend.right, width = 1))
            chLabels.push(label.new(na, na, "", style = label.style_label_left, size = size.tiny))
    for ln in chLines
        ln.set_color(color.new(C_MUTED, 100))
    for lb in chLabels
        lb.set_text("")
    bool impLike = m3On and not wCorr and wN >= 4
    int xR = bar_index + lblOffset
    int nCh = 0
    if impLike
        // y(x) = y1 + slope * (x - x1)
        if m5Base
            float sl = (wPx.get(3) - wPx.get(1)) / (wBar.get(3) - wBar.get(1))
            float w = (wPx.get(1) + sl * (wBar.get(2) - wBar.get(1))) - wPx.get(2)    // ширина канала 1-3 по вертикали
            array<float> y0 = array.from(wPx.get(1), wPx.get(2), wPx.get(1) - w / 2, wPx.get(2) - w)
            array<string> nm = array.from("линия 1-3", "параллель через 2", "мин. цель 4 (средняя)", "граница (удвоенный канал)")
            for j = 0 to 3
                int x1 = j == 1 or j == 3 ? wBar.get(2) : wBar.get(1)
                float y1 = y0.get(j)
                line ln = chLines.get(nCh)
                ln.set_xy1(x1, y1)
                ln.set_xy2(x1 + 1, y1 + sl)
                ln.set_color(color.new(C_MUTED, j >= 2 ? 30 : 10))
                ln.set_style(j >= 2 ? line.style_dotted : line.style_solid)
                if dl >= 1
                    label lb = chLabels.get(nCh)
                    lb.set_xy(xR, y1 + sl * (xR - x1))
                    lb.set_text(nm.get(j))
                    lb.set_textcolor(C_MUTED)
                    lb.set_color(color.new(C_BG, 30))
                nCh += 1
        if m5Ch4 and wN >= 5
            float sl4 = (wPx.get(4) - wPx.get(2)) / (wBar.get(4) - wBar.get(2))
            array<int> px = array.from(2, 3, 1)
            array<string> nm4 = array.from("линия 2-4", "цель волны 5 (через 3)", "параллель через 1")
            int jMax = m5Via1 or dl == 2 ? 2 : 1
            for j = 0 to jMax
                int k = px.get(j)
                line ln = chLines.get(nCh)
                ln.set_xy1(wBar.get(k), wPx.get(k))
                ln.set_xy2(wBar.get(k) + 1, wPx.get(k) + sl4)
                ln.set_color(color.new(wCol, j == 0 ? 10 : 30))
                ln.set_style(j == 0 ? line.style_solid : line.style_dashed)
                if dl >= 1
                    label lb = chLabels.get(nCh)
                    lb.set_xy(xR, wPx.get(k) + sl4 * (xR - wBar.get(k)))
                    lb.set_text(nm4.get(j))
                    lb.set_textcolor(wCol)
                    lb.set_color(color.new(C_BG, 30))
                nCh += 1

// ============================================================================
// M6. Anchored VWAP (hlc3)
// От C — переякоривается вместе со структурой; пока C не подтверждён, линия бледная
// (может переякориться). В момент переякоривания линия прерывается.
// ============================================================================
const string G6 = "6. Anchored VWAP"
bool vwFromC = input.bool(true, "От C (авто)", group = G6)
bool vwFromA = input.bool(false, "От A (авто)", group = G6)
bool vwManual = input.bool(false, "От даты", group = G6, inline = "vm")
// 1789430400000 = 15.09.2026 00:00 UTC (defval — только числом, timestamp() сюда нельзя)
int vwT = input.time(1789430400000, "", confirm = false, group = G6, inline = "vm")

float vwC = hasStruct and hasVol and cumV - cV0 > 0 ? (cumPV - cPV0) / (cumV - cV0) : na
float vwA = hasStruct and hasVol and cumV - aV0 > 0 ? (cumPV - aPV0) / (cumV - aV0) : na
bool cMoved = cBar != cBar[1] or sCand != sCand[1]
bool aMoved = aBar != aBar[1]

var array<TPt> vwPts = f_newPts(array.from(vwT))
f_detect(vwPts)
TPt vwP = vwPts.get(0)
float vwM = vwP.done and hasVol and cumV - vwP.v0 > 0 ? (cumPV - vwP.pv0) / (cumV - vwP.v0) : na

plot(vwFromC and not cMoved ? vwC : na, "AVWAP от C", color = color.new(C_VW, sCand == 1 ? 55 : 0), linewidth = 2, style = plot.style_linebr)
plot(vwFromA and not aMoved ? vwA : na, "AVWAP от A", color = color.new(C_VW, 40), linewidth = 1, style = plot.style_linebr)
plot(vwManual ? vwM : na, "AVWAP от даты", color = color.new(C_ACC, 0), linewidth = 2, style = plot.style_linebr)

// ============================================================================
// M7. Профиль объёма фиксированного диапазона
// Объём бара делится между ценовыми уровнями пропорционально пересечению [low; high]
// с уровнем. Считается только на последнем баре, по ограниченному числу баров.
// ============================================================================
const string G7 = "7. Профиль объёма"
const string VP_AB = "Нога A-B"
const string VP_AC = "Структура A-C"
const string VP_MAN = "Вручную по датам"
bool m7On = input.bool(true, "Включить профиль", group = G7)
string vpSrc = input.string(VP_AB, "Диапазон", options = [VP_AB, VP_AC, VP_MAN], group = G7)
int vpT1 = input.time(0, "Начало (вручную)", confirm = false, group = G7)
int vpT2 = input.time(0, "Конец (вручную)", confirm = false, group = G7)
int vpRows = input.int(40, "Уровней", minval = 10, maxval = 100, group = G7)
float vpVA = input.float(70.0, "Value Area, %", minval = 50.0, maxval = 95.0, step = 5.0, group = G7)
bool vpBars = input.bool(true, "Горизонтальные бары справа от диапазона", group = G7,
     tooltip = "В детализации «Минимум» рисуются только POC и границы Value Area.")
int vpWidth = input.int(30, "Ширина баров профиля, баров графика", minval = 5, maxval = 200, group = G7)
int vpMaxBars = input.int(1500, "Не больше баров в диапазоне", minval = 50, maxval = 3000, group = G7,
     tooltip = "Ограничение объёма вычислений. Длинный диапазон обрезается слева.")

var array<TPt> vpPts = f_newPts(array.from(vpT1, vpT2))
f_detect(vpPts)

// копии рядов с явным буфером истории для ограниченного цикла на последнем баре
float hiS = high
float loS = low
float vS = volZ
max_bars_back(hiS, 5000)
max_bars_back(loS, 5000)
max_bars_back(vS, 5000)

var array<box> vpBoxes = array.new<box>()
var array<line> vpLines = array.new<line>()
var array<label> vpLabels = array.new<label>()
string vpNote = ""
float vpPoc = na
float vpVah = na
float vpVal = na

if barstate.islast
    if vpLines.size() == 0
        for i = 0 to 2
            vpLines.push(line.new(na, na, na, na, width = 2))
            vpLabels.push(label.new(na, na, "", style = label.style_label_left, size = size.tiny))
        for i = 0 to 99
            vpBoxes.push(box.new(na, na, na, na, border_color = color.new(C_ACC, 100), bgcolor = color.new(C_ACC, 100)))
    for b in vpBoxes
        b.set_bgcolor(color.new(C_ACC, 100))
    for ln in vpLines
        ln.set_color(color.new(C_MUTED, 100))
    for lb in vpLabels
        lb.set_text("")
    int r1 = na
    int r2 = na
    if vpSrc == VP_MAN
        if vpPts.get(0).done and vpPts.get(1).done
            r1 := vpPts.get(0).bar
            r2 := vpPts.get(1).bar
    else if hasStruct
        r1 := aBar
        r2 := vpSrc == VP_AB ? bBar : cBar
    if not m7On
        vpNote := "профиль выключен"
    else if not hasVol
        vpNote := "объём недоступен для этого символа — профиль отключён"
    else if na(r1) or na(r2) or r2 < r1
        vpNote := "нет диапазона для профиля"
    else if bar_index - r1 > 4999
        vpNote := "диапазон слишком далеко в прошлом (> 5000 баров)"
    else
        if r2 - r1 + 1 > vpMaxBars
            r1 := r2 - vpMaxBars + 1
            vpNote := "диапазон обрезан до " + str.tostring(vpMaxBars) + " баров"
        float lo = na
        float hi = na
        for j = r1 to r2
            lo := na(lo) ? loS[bar_index - j] : math.min(lo, loS[bar_index - j])
            hi := na(hi) ? hiS[bar_index - j] : math.max(hi, hiS[bar_index - j])
        if hi > lo
            float step = (hi - lo) / vpRows
            array<float> vols = array.new<float>(vpRows, 0.0)
            for j = r1 to r2
                float h = hiS[bar_index - j]
                float l = loS[bar_index - j]
                float v = vS[bar_index - j]
                if v > 0
                    if h <= l
                        int kk = math.min(int((l - lo) / step), vpRows - 1)
                        vols.set(kk, vols.get(kk) + v)
                    else
                        int k0 = math.max(0, math.min(int((l - lo) / step), vpRows - 1))
                        int k1 = math.max(0, math.min(int((h - lo) / step), vpRows - 1))
                        for k = k0 to k1
                            float ov = math.min(h, lo + (k + 1) * step) - math.max(l, lo + k * step)
                            if ov > 0
                                vols.set(k, vols.get(k) + v * ov / (h - l))
            float total = vols.sum()
            int poc = vols.indexof(vols.max())
            int up = poc + 1
            int dn = poc - 1
            int top = poc
            int bot = poc
            float acc = vols.get(poc)
            while acc < vpVA / 100.0 * total and (up < vpRows or dn >= 0)
                float vu = up < vpRows ? vols.get(up) : -1.0
                float vd = dn >= 0 ? vols.get(dn) : -1.0
                if vu >= vd
                    acc += vu
                    top := up
                    up += 1
                else
                    acc += vd
                    bot := dn
                    dn -= 1
            vpPoc := lo + (poc + 0.5) * step
            vpVah := lo + (top + 1) * step
            vpVal := lo + bot * step
            float vmax = vols.max()
            if vpBars and dl >= 1 and vmax > 0
                for k = 0 to vpRows - 1
                    float vk = vols.get(k)
                    if vk > 0
                        int w = math.max(1, int(math.round(vpWidth * vk / vmax)))
                        int tr = k == poc ? 35 : k >= bot and k <= top ? 65 : 85
                        box bx = vpBoxes.get(k)
                        bx.set_lefttop(r2 + 1, lo + (k + 1) * step)
                        bx.set_rightbottom(r2 + 1 + w, lo + k * step)
                        bx.set_bgcolor(color.new(C_ACC, tr))
            array<float> ys = array.from(vpPoc, vpVah, vpVal)
            array<string> nm = array.from("POC", "VAH", "VAL")
            for i = 0 to 2
                line ln = vpLines.get(i)
                ln.set_xy1(r1, ys.get(i))
                ln.set_xy2(r2 + vpWidth + 2, ys.get(i))
                ln.set_color(color.new(C_ACC, i == 0 ? 0 : 40))
                ln.set_style(i == 0 ? line.style_solid : line.style_dashed)
                label lb = vpLabels.get(i)
                lb.set_xy(r2 + vpWidth + 2, ys.get(i))
                lb.set_text(nm.get(i) + " " + str.tostring(ys.get(i), format.mintick))
                lb.set_textcolor(C_ACC)
                lb.set_color(color.new(C_BG, 30))
