//@version=6
// ============================================================================
// TW Спидометр — скорость + ускорение
// Проверка волновой разметки Эллиотта по скорости цены (методика tradewaves.ru/teoriya/macd/,
// идеи Б. Вильямса и pr0 / RSWA). Это инструмент ПРОВЕРКИ разметки, а не торговая система:
// сигналов «купить/продать» нет.
//   СКОРОСТЬ  = EMA(5) - EMA(34) от 100 * ln(close) — линейный MACD, значения в %.
//   УСКОРЕНИЕ = скорость - EMA(скорости, 5) — гистограмма MACD 5/34/5.
//   Высота столбика = скорость, яркость = ускорение по направлению движения.
// Эталон для сверки: reference/speedometer.py
// ============================================================================
indicator("TW Спидометр — скорость + ускорение", shorttitle = "TW Спидометр", overlay = false, precision = 3,
     max_lines_count = 300, max_labels_count = 300, max_polylines_count = 5)

// ============================================================================
// Интерфейс: тема и палитра (объявлены первыми — от них зависят цвета всех модулей)
// ============================================================================
const string G0 = "0. Интерфейс"
const string T_AUTO = "Авто (по фону графика)"
const string T_LIGHT = "Светлая"
const string T_DARK = "Тёмная"
string themeIn = input.string(T_AUTO, "Тема", options = [T_AUTO, T_LIGHT, T_DARK], group = G0,
     tooltip = "«Авто» определяет тему по яркости фона графика (chart.bg_color). Палитра Okabe-Ito различима при дальтонизме; фаза дополнительно подписана словами в таблице.")

color bgC = chart.bg_color
bool autoDark = color.r(bgC) * 0.299 + color.g(bgC) * 0.587 + color.b(bgC) * 0.114 < 128
bool isDark = themeIn == T_AUTO ? autoDark : themeIn == T_DARK

// Okabe-Ito: синий — рост (скорость >= 0), оранжевый — спад (скорость < 0).
color C_UP = isDark ? #56B4E9 : #0072B2
color C_DN = isDark ? #E69F00 : #D55E00
color C_ACC = #CC79A7
color C_TX = isDark ? #D1D4DC : #131722
color C_TBL_BG = isDark ? color.new(#1E222D, 5) : color.new(#F0F3FA, 5)
color C_TBL_HD = isDark ? #2A2E39 : #DDE2EC

// ============================================================================
// 1. Скорость, ускорение и визуал
// ============================================================================
const string G1 = "1. Скорость"
const string P_W = "Williams 5/34/5"
const string P_B = "Крупная фигура 13/55/13"
const string P_C = "Классика 12/26/9"
const string P_U = "Свои"
string presetIn = input.string(P_W, "Пресет периодов", options = [P_W, P_B, P_C, P_U], group = G1,
     tooltip = "Williams 5/34/5 — основной спидометр методики. 13/55/13 — для крупных фигур. 12/26/9 — классический MACD. «Свои» — периоды из полей ниже.")
int fastIn = input.int(5, "Быстрая EMA («Свои»)", minval = 1, group = G1, inline = "p")
int slowIn = input.int(34, "медленная", minval = 2, group = G1, inline = "p")
int sigIn = input.int(5, "EMA ускорения («Свои»)", minval = 1, group = G1,
     tooltip = "Ускорение = скорость - EMA(скорости, этот период). Поля этой строки и строки выше действуют только при пресете «Свои».")
bool useLog = input.bool(true, "Скорость от логарифма цены (x100, в %)", group = G1,
     tooltip = "Включено: источник = 100 * ln(close), скорость — в процентах, пики сравнимы при любом уровне цены. Выключено: скорость в единицах цены.")
int paleTr = input.int(60, "Прозрачность фазы «замедляется», %", minval = 10, maxval = 90, group = G1,
     tooltip = "Яркий столбик — скорость ускоряется в сторону движения, бледный — замедляется.")

int fastLen = presetIn == P_W ? 5 : presetIn == P_B ? 13 : presetIn == P_C ? 12 : fastIn
int slowLen = presetIn == P_W ? 34 : presetIn == P_B ? 55 : presetIn == P_C ? 26 : slowIn
int sigLen = presetIn == P_W ? 5 : presetIn == P_B ? 13 : presetIn == P_C ? 9 : sigIn

const string G2 = "2. Ускорение"
const string A_LINE = "Линия поверх (фиксированный множитель)"
const string A_AUTO = "Авто-масштаб (один раз по истории)"
const string A_BAND = "Полоса у нуля"
const string A_OFF = "Не показывать"
string accModeIn = input.string(A_LINE, "Отображение ускорения", options = [A_LINE, A_AUTO, A_BAND, A_OFF], group = G2,
     tooltip = "Линия поверх: ускорение x множитель. Авто-масштаб: множитель = P(|скорости|) / P(|ускорения|) за последние N баров, считается один раз на последнем баре и одинаков для всей нарисованной линии. Полоса: квадраты на нуле — цвет = знак ускорения, насыщенность = сила (без масштаба).")
float accMult = input.float(3.0, "Множитель (линия поверх)", minval = 0.1, maxval = 100.0, step = 0.5, group = G2,
     tooltip = "Также используется в авто-режиме, пока истории меньше N баров.")
int autoLen = input.int(500, "Авто-масштаб: окно N баров", minval = 50, maxval = 2000, group = G2,
     tooltip = "Сколько последних баров учитывать при расчёте множителя и сколько баров рисовать линией в авто-режиме.")
float autoPct = input.float(95.0, "Авто-масштаб: перцентиль, %", minval = 50.0, maxval = 100.0, step = 1.0, group = G2)

const string G3 = "3. Уровни"
float lvl = input.float(0.0, "Уровни ±X (0 = выкл.)", minval = 0.0, step = 0.5, group = G3,
     tooltip = "Горизонтальные уровни +X и -X в единицах скорости (в % при включённом логарифме). Например, 5 — уровни ±5 %.")

// Ядро: [скорость, ускорение]. Все ta.* — безусловно; функция вызывается на глобальном уровне
// и внутри request.security (модуль 5).
f_speed(bool lg, int fL, int sL, int gL) =>
    float src = lg ? 100.0 * math.log(close) : close
    float spd = ta.ema(src, fL) - ta.ema(src, sL)
    [spd, spd - ta.ema(spd, gL)]

[speed, accel] = f_speed(useLog, fastLen, slowLen, sigLen)

// Фаза: 1 — рост ускоряется, 2 — рост замедляется, 3 — спад ускоряется, 4 — спад замедляется, 0 — нет данных.
f_phaseId(float s, float a) =>
    int id = 0
    if not na(s) and not na(a)
        id := s >= 0 ? (a > 0 ? 1 : 2) : (a < 0 ? 3 : 4)
    id

f_phaseName(int id) =>
    switch id
        1 => "рост ускоряется"
        2 => "рост замедляется"
        3 => "спад ускоряется"
        4 => "спад замедляется"
        => "нет данных"

f_phaseColor(int id) =>
    switch id
        1 => C_UP
        2 => color.new(C_UP, paleTr)
        3 => C_DN
        4 => color.new(C_DN, paleTr)
        => color.gray

int phaseId = f_phaseId(speed, accel)
string unitTxt = useLog ? " %" : ""

plot(speed, "Скорость", color = f_phaseColor(phaseId), style = plot.style_columns)
hline(0, "Ноль", color = color.new(color.gray, 30), linestyle = hline.style_solid)
hline(lvl, "Уровень +X", color = lvl > 0 ? color.new(color.gray, 40) : color.new(color.gray, 100), linestyle = hline.style_dashed)
hline(-lvl, "Уровень -X", color = lvl > 0 ? color.new(color.gray, 40) : color.new(color.gray, 100), linestyle = hline.style_dashed)

// --- ускорение: линия поверх (фиксированный множитель)
plot(accModeIn == A_LINE ? accel * accMult : na, "Ускорение x множитель", color = C_ACC, linewidth = 2)

// --- ускорение: авто-масштаб. Перцентили считаются на каждом баре, но множитель берётся
// ОДИН раз — на последнем баре — и вся линия за N баров перерисовывается с ним (polyline),
// поэтому масштаб одинаков для всей видимой истории.
float pSpd = ta.percentile_linear_interpolation(math.abs(speed), autoLen, autoPct)
float pAcc = ta.percentile_linear_interpolation(math.abs(accel), autoLen, autoPct)
float accHist = accel
max_bars_back(accHist, 2000)
var polyline accPoly = na
var float autoMult = na

if barstate.islast and accModeIn == A_AUTO
    autoMult := pAcc > 0 ? pSpd / pAcc : na
    float mUse = na(autoMult) ? accMult : autoMult
    int n = math.min(autoLen, bar_index + 1)
    array<chart.point> pts = array.new<chart.point>()
    // ограниченный цикл: не больше autoLen (<= 2000) последних баров, max_bars_back задан
    for i = n - 1 to 0
        float av = accHist[i]
        if not na(av)
            pts.push(chart.point.from_index(bar_index - i, av * mUse))
    if not na(accPoly)
        accPoly.delete()
    accPoly := polyline.new(pts, line_color = C_ACC, line_width = 2)

// --- ускорение: полоса у нуля (знак — цветом и формой, сила — насыщенностью)
float accStr = pAcc > 0 ? math.min(math.abs(accel) / pAcc, 1.0) : 0.5
int bandTr = int(math.round(85 - 75 * accStr))
color bandCol = accel > 0 ? color.new(C_UP, bandTr) : color.new(C_DN, bandTr)
plotshape(accModeIn == A_BAND and accel > 0 ? 0.0 : na, "Ускорение > 0 (полоса)", style = shape.triangleup,
     location = location.absolute, color = bandCol, size = size.tiny)
plotshape(accModeIn == A_BAND and accel <= 0 ? 0.0 : na, "Ускорение <= 0 (полоса)", style = shape.triangledown,
     location = location.absolute, color = bandCol, size = size.tiny)

// --- подпись у правого края: «ускорение xN»
var label accLbl = na
if barstate.islast
    float mShow = accModeIn == A_AUTO ? (na(autoMult) ? accMult : autoMult) : accMult
    string lblTxt = accModeIn == A_LINE ? "ускорение x" + str.tostring(accMult, "0.0#") :
         accModeIn == A_AUTO ? "ускорение x" + str.tostring(mShow, "0.0#") + (na(autoMult) ? " (мало истории)" : " (авто)") :
         accModeIn == A_BAND ? "ускорение: полоса" : ""
    float lblY = accModeIn == A_BAND ? 0.0 : nz(accel) * mShow
    if na(accLbl)
        accLbl := label.new(bar_index, 0.0, "", style = label.style_label_left, color = color.new(color.white, 100), size = size.small)
    label.set_xy(accLbl, bar_index + 2, lblY)
    label.set_text(accLbl, lblTxt)
    label.set_textcolor(accLbl, C_ACC)

// Значения для сверки с reference/speedometer.py (окно данных; на панели не рисуются).
plot(speed, "Сверка: скорость", display = display.data_window)
plot(accel, "Сверка: ускорение", display = display.data_window)
plot(phaseId, "Сверка: фаза (1-4)", display = display.data_window)

// ============================================================================
// 2. Ранние сигналы
// Смена знака ускорения — ранний признак смены фазы. Смена знака скорости = пересечение
// EMA fast/slow = конец слепой зоны (от экстремума цены до пересечения линия показывает старый тренд).
// ============================================================================
const string G4 = "4. Ранние сигналы"
bool showAccSig = input.bool(true, "Треугольники смены знака ускорения", group = G4,
     tooltip = "Треугольник вверх внизу панели — ускорение стало > 0, вниз вверху панели — стало < 0.")
bool showSpdSig = input.bool(true, "Маркер смены знака скорости (конец слепой зоны)", group = G4,
     tooltip = "Ромб на нулевой линии с подписью «СЗ»: скорость сменила знак, EMA fast/slow пересеклись — слепая зона закончилась.")
bool onlyClosed = input.bool(true, "Только после закрытия бара", group = G4,
     tooltip = "Сигнал на текущей свече появится только после её закрытия (barstate.isconfirmed). На истории все бары закрыты, поэтому история не меняется.")

// ta.* — на глобальном уровне, затем фильтр закрытия бара
bool accUpRaw = ta.crossover(accel, 0)
bool accDnRaw = ta.crossunder(accel, 0)
bool spdUpRaw = ta.crossover(speed, 0)
bool spdDnRaw = ta.crossunder(speed, 0)
bool barOk = not onlyClosed or barstate.isconfirmed
bool accUp = accUpRaw and barOk
bool accDn = accDnRaw and barOk
bool spdUp = spdUpRaw and barOk
bool spdDn = spdDnRaw and barOk

plotshape(showAccSig and accUp, "Ускорение стало > 0", style = shape.triangleup, location = location.bottom,
     color = C_UP, size = size.tiny)
plotshape(showAccSig and accDn, "Ускорение стало < 0", style = shape.triangledown, location = location.top,
     color = C_DN, size = size.tiny)
plotshape(showSpdSig and spdUp ? 0.0 : na, "Скорость стала > 0 (конец слепой зоны)", style = shape.diamond,
     location = location.absolute, color = C_UP, size = size.small, text = "СЗ", textcolor = C_UP)
plotshape(showSpdSig and spdDn ? 0.0 : na, "Скорость стала < 0 (конец слепой зоны)", style = shape.diamond,
     location = location.absolute, color = C_DN, size = size.small, text = "СЗ", textcolor = C_DN)

// ============================================================================
// 3. Дивергенции по скорости
// Пивот подтверждается через «баров справа» закрытых баров, поэтому сигнал запаздывает
// ровно на это число баров. Это не перерисовка: нарисованное потом не меняется.
// ============================================================================
const string G5 = "5. Дивергенции (по скорости)"
bool showReg = input.bool(true, "Обычные", group = G5, inline = "dk")
bool showHid = input.bool(false, "Скрытые", group = G5, inline = "dk",
     tooltip = "Обычная: цена обновила экстремум, а пик скорости слабее (сплошная линия). Скрытая: цена не обновила экстремум, а скорость обновила (пунктир).")
int pL = input.int(5, "Пивот: баров слева", minval = 1, maxval = 50, group = G5, inline = "pv")
int pR = input.int(5, "справа", minval = 1, maxval = 50, group = G5, inline = "pv",
     tooltip = "Баров справа = запаздывание сигнала.")
int minDist = input.int(5, "Расстояние между пивотами: мин.", minval = 1, group = G5, inline = "ds")
int maxDist = input.int(80, "макс.", minval = 2, maxval = 1000, group = G5, inline = "ds")
int priceWin = input.int(2, "Окно экстремума цены, баров в каждую сторону", minval = 0, maxval = 50, group = G5,
     tooltip = "Цена сравнивается по low (для впадин) или high (для пиков) в окне вокруг пивота скорости, а не по close. Окно не больше «баров справа».")
float minDiffPct = input.float(5.0, "Мин. разница, % от диапазона скорости", minval = 0.0, maxval = 100.0, step = 0.5, group = G5, inline = "md")
int rangeLen = input.int(200, "за баров", minval = 10, group = G5, inline = "md",
     tooltip = "|разница двух пивотов скорости| должна быть не меньше этой доли от (максимум - минимум) скорости за указанное число баров — отсекает шумовые дивергенции.")
bool signFilter = input.bool(true, "Обычные: бычьи только ниже нуля, медвежьи — выше", group = G5,
     tooltip = "Оба пивота обычной дивергенции должны быть по одну сторону нуля. К скрытым не применяется: они бывают по любую сторону нуля.")
int maxDiv = input.int(30, "Хранить последних дивергенций", minval = 1, maxval = 100, group = G5,
     tooltip = "Старые линии и метки удаляются (массив + delete).")

int wEff = math.min(priceWin, pR)
float phV = ta.pivothigh(speed, pL, pR)
float plV = ta.pivotlow(speed, pL, pR)
float loWin = ta.lowest(low, 2 * wEff + 1)
float hiWin = ta.highest(high, 2 * wEff + 1)
float pxLoAtPivot = loWin[pR - wEff]    // минимум low в [пивот - w; пивот + w]
float pxHiAtPivot = hiWin[pR - wEff]    // максимум high в [пивот - w; пивот + w]
float spdRange = ta.highest(speed, rangeLen) - ta.lowest(speed, rangeLen)

// последний пивот каждого типа
var int loBar = na
var float loSpd = na
var float loPx = na
var int hiBar = na
var float hiSpd = na
var float hiPx = na

var array<line> divLines = array.new<line>()
var array<label> divLabels = array.new<label>()

f_drawDiv(int x1, float y1, int x2, float y2, bool bull, bool hidden, string txt) =>
    color c = bull ? C_UP : C_DN
    divLines.push(line.new(x1, y1, x2, y2, color = c, width = 2, style = hidden ? line.style_dashed : line.style_solid))
    divLabels.push(label.new(x2, y2, txt, color = color.new(c, 15), textcolor = color.white, size = size.tiny,
         style = bull ? label.style_label_up : label.style_label_down))
    if divLines.size() > maxDiv
        divLines.shift().delete()
    if divLabels.size() > maxDiv
        divLabels.shift().delete()

bool bullReg = false
bool bullHid = false
bool bearReg = false
bool bearHid = false

if not na(plV)
    int cb = bar_index - pR
    if not na(loBar) and not na(pxLoAtPivot)
        int dist = cb - loBar
        bool distOk = dist >= minDist and dist <= maxDist
        bool diffOk = not na(spdRange) and math.abs(plV - loSpd) >= minDiffPct / 100.0 * spdRange
        bool signOk = not signFilter or (plV < 0 and loSpd < 0)
        if distOk and diffOk
            if showReg and signOk and pxLoAtPivot < loPx and plV > loSpd
                bullReg := true
                f_drawDiv(loBar, loSpd, cb, plV, true, false, "Бычья")
            if showHid and pxLoAtPivot > loPx and plV < loSpd
                bullHid := true
                f_drawDiv(loBar, loSpd, cb, plV, true, true, "Скр. бычья")
    loBar := cb
    loSpd := plV
    loPx := pxLoAtPivot

if not na(phV)
    int cb = bar_index - pR
    if not na(hiBar) and not na(pxHiAtPivot)
        int dist = cb - hiBar
        bool distOk = dist >= minDist and dist <= maxDist
        bool diffOk = not na(spdRange) and math.abs(phV - hiSpd) >= minDiffPct / 100.0 * spdRange
        bool signOk = not signFilter or (phV > 0 and hiSpd > 0)
        if distOk and diffOk
            if showReg and signOk and pxHiAtPivot > hiPx and phV < hiSpd
                bearReg := true
                f_drawDiv(hiBar, hiSpd, cb, phV, false, false, "Медвежья")
            if showHid and pxHiAtPivot < hiPx and phV > hiSpd
                bearHid := true
                f_drawDiv(hiBar, hiSpd, cb, phV, false, true, "Скр. медвежья")
    hiBar := cb
    hiSpd := phV
    hiPx := pxHiAtPivot

// ============================================================================
// 4. Режим «Пики волн 1-3-5»
// Пользователь задаёт даты точек 0..5. Бар точки — первый бар, у которого время закрытия
// позже заданного (свеча, содержащая эту дату, или первая после разрыва). Экстремумы скорости
// по отрезкам копятся «на ходу» через var — без циклов по истории. Рисование — на последнем баре.
// ============================================================================
const string G6 = "6. Пики волн 1-3-5"
// 0 = точка не задана. Пример даты: 1789430400000 = 15.09.2026 00:00 UTC (только число, не timestamp()).
int wt0 = input.time(0, "Точка 0 (начало)", confirm = false, group = G6,
     tooltip = "Задайте даты точек 0-5 изучаемой волны. Режим включается, когда заданы хотя бы точки 0 и 1; классификация — когда заданы все шесть. Если точки не заданы, режим ничего не рисует.")
int wt1 = input.time(0, "Точка 1", confirm = false, group = G6)
int wt2 = input.time(0, "Точка 2", confirm = false, group = G6)
int wt3 = input.time(0, "Точка 3", confirm = false, group = G6)
int wt4 = input.time(0, "Точка 4", confirm = false, group = G6)
int wt5 = input.time(0, "Точка 5 (конец)", confirm = false, group = G6)
float k4 = input.float(0.35, "k: волна 4 «у нуля», если |экстремум 4| < k x |пик 3|", minval = 0.05, maxval = 1.0, step = 0.05, group = G6)
bool showPeakLbl = input.bool(true, "Метки пиков и линия 1-3-5", group = G6)

var array<int> wT = array.from(wt0, wt1, wt2, wt3, wt4, wt5)
var array<bool> ptDone = array.new<bool>(6, false)
var array<int> ptBar = array.new<int>(6, na)
var array<float> ptCl = array.new<float>(6, na)
var array<float> sMax = array.new<float>(5, na)     // волна k = индекс k-1
var array<int> sMaxT = array.new<int>(5, na)
var array<float> sMin = array.new<float>(5, na)
var array<int> sMinT = array.new<int>(5, na)

bool waveOn = wt0 > 0 and wt1 > 0
int tcNow = na(time_close) ? time : time_close
if waveOn
    // фиксированные циклы по 6 точкам и 5 отрезкам (не по истории)
    for i = 0 to 5
        int ti = wT.get(i)
        if ti > 0 and not ptDone.get(i) and tcNow > ti
            ptDone.set(i, true)
            ptBar.set(i, bar_index)
            ptCl.set(i, close)
    for k = 1 to 5
        bool both = wT.get(k - 1) > 0 and wT.get(k) > 0
        bool inSeg = both and ptDone.get(k - 1) and (not ptDone.get(k) or ptBar.get(k) == bar_index)
        if inSeg and not na(speed)
            int j = k - 1
            if na(sMax.get(j)) or speed > sMax.get(j)
                sMax.set(j, speed)
                sMaxT.set(j, time)
            if na(sMin.get(j)) or speed < sMin.get(j)
                sMin.set(j, speed)
                sMinT.set(j, time)

// Классификация профиля. a1, a3, a5 — пики со знаком направления волны, c4 — экстремум волны 4 против направления.
f_classify(float a1, float a3, float a5, float c4, float k) =>
    string res = "неопределённо"
    if not (na(a1) or na(a3) or na(a5) or na(c4))
        if a3 > a1 and a3 > a5 and a3 > 0
            res := math.abs(c4) < k * a3 ? "импульс" : "неопределённо (волна 4 не вернулась к нулю)"
        else if a1 > a3 and a3 > a5
            res := "сужающаяся диагональ (затухание)"
        else if a1 < a3 and a3 < a5
            res := "расширяющаяся диагональ (возрастание)"
    res

var array<label> pkLabels = array.new<label>()
var array<line> pkLines = array.new<line>()
string profileTxt = ""      // для таблицы (модуль 5); пусто — режим выключен

if barstate.islast and waveOn
    while pkLabels.size() > 0
        pkLabels.pop().delete()
    while pkLines.size() > 0
        pkLines.pop().delete()
    bool ordered = true
    for i = 1 to 5
        if wT.get(i) > 0 and wT.get(i) <= wT.get(i - 1)
            ordered := false
    if not ptDone.get(0) or not ptDone.get(1)
        profileTxt := "точки 0-1 вне загруженной истории"
    else if not ordered
        profileTxt := "точки идут не по порядку дат"
    else
        bool has5 = wT.get(5) > 0 and ptDone.get(5)
        int s = (has5 ? ptCl.get(5) > ptCl.get(0) : ptCl.get(1) > ptCl.get(0)) ? 1 : -1
        array<float> pv = array.new<float>(5, na)
        array<int> pt = array.new<int>(5, na)
        int nSeg = 0
        for j = 0 to 4
            bool segOk = wT.get(j) > 0 and wT.get(j + 1) > 0 and ptDone.get(j) and ptDone.get(j + 1) and ptBar.get(j + 1) > ptBar.get(j)
            if segOk
                bool wantMax = (j % 2 == 0) == (s == 1)
                pv.set(j, wantMax ? sMax.get(j) : sMin.get(j))
                pt.set(j, wantMax ? sMaxT.get(j) : sMinT.get(j))
                nSeg += 1
                if showPeakLbl and not na(pv.get(j))
                    color pc = pv.get(j) >= 0 ? C_UP : C_DN
                    pkLabels.push(label.new(pt.get(j), pv.get(j), (j % 2 == 0 ? "пик " : "экстр. ") + str.tostring(j + 1),
                         xloc = xloc.bar_time, color = color.new(pc, 20), textcolor = color.white, size = size.small,
                         style = pv.get(j) * s >= 0 ? label.style_label_down : label.style_label_up))
        if showPeakLbl
            for j = 0 to 2 by 2
                if not na(pv.get(j)) and not na(pv.get(j + 2))
                    pkLines.push(line.new(pt.get(j), pv.get(j), pt.get(j + 2), pv.get(j + 2), xloc = xloc.bar_time,
                         color = C_ACC, width = 2))
        if nSeg == 5
            profileTxt := f_classify(s * pv.get(0), s * pv.get(2), s * pv.get(4), pv.get(3), k4)
        else
            profileTxt := "задайте все точки 0-5 для классификации"
        if showPeakLbl and nSeg == 5 and not na(pv.get(4))
            pkLabels.push(label.new(pt.get(4), 0.0, profileTxt + "\nпрофиль скорости, не разметка", xloc = xloc.bar_time,
                 color = color.new(C_TBL_BG, 0), textcolor = C_TX, size = size.small,
                 style = s == 1 ? label.style_label_up : label.style_label_down))
