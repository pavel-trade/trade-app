//@version=6
// ============================================================================
// TW Спидометр Pro
// Проверка волновой разметки Эллиотта через скорость цены.
// Спидометр = линейный MACD: EMA(fast) - EMA(slow) от 100 * ln(цены), значения в %.
// Источники идеи: tradewaves.ru/teoriya/macd/, Б. Вильямс (AO 5/34), исследования pr0 / RSWA.
// Это инструмент ПРОВЕРКИ разметки, а не торговая система: сигналов покупки/продажи нет.
// Эталон для сверки значений: reference/speedometer.py
// ============================================================================
indicator("TW Спидометр Pro", shorttitle = "TW Спидометр", overlay = false, precision = 3,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ============================================================================
// A. Ядро
// ============================================================================
const string GA = "1. Спидометр (ядро)"
const string P_W = "Williams 5/34/5"
const string P_B = "Крупная фигура 13/55/13"
const string P_C = "Классика 12/26/9"
const string P_U = "Свои"
const string N_PCT = "% от логарифма (как есть)"
const string N_ATR = "В единицах ATR"

string presetIn = input.string(P_W, "Пресет периодов", options = [P_W, P_B, P_C, P_U], group = GA,
     tooltip = "Williams 5/34/5 — основной спидометр по методике. 13/55/13 — для крупных фигур. 12/26/9 — классический MACD. «Свои» — периоды из трёх полей ниже.")
int fastIn = input.int(5, "Быстрая EMA (для «Свои»)", minval = 1, group = GA,
     tooltip = "Используется только при пресете «Свои».")
int slowIn = input.int(34, "Медленная EMA (для «Свои»)", minval = 2, group = GA,
     tooltip = "Используется только при пресете «Свои». Должна быть больше быстрой.")
int sigIn = input.int(5, "Сигнальная EMA (для «Свои»)", minval = 1, group = GA,
     tooltip = "Используется только при пресете «Свои».")
bool useLog = input.bool(true, "Считать от логарифма цены (x100, значения в %)", group = GA,
     tooltip = "Включено (по умолчанию): источник = 100 * ln(close). Тогда MACD показывает разницу средних в процентах, и пики сравнимы при любом уровне цены (BTC 20k и 120k). Выключено: MACD в единицах цены.")
string normIn = input.string(N_PCT, "Нормировка", options = [N_PCT, N_ATR], group = GA,
     tooltip = "«% от логарифма» — значения как есть. «В единицах ATR» — MACD, сигнальная, гистограмма и AO делятся на ATR в тех же единицах: удобно сравнивать разные инструменты.")
int atrLen = input.int(14, "Период ATR (для нормировки)", minval = 1, group = GA,
     tooltip = "ATR считается как RMA истинного диапазона в тех же единицах, что и MACD (логарифм или цена).")
int aoFast = input.int(5, "AO: быстрая SMA", minval = 1, group = GA, inline = "ao",
     tooltip = "Awesome Oscillator Б. Вильямса: SMA(5) - SMA(34) от медианы hl2 (от логарифма x100, если он включён).")
int aoSlow = input.int(34, "медленная", minval = 2, group = GA, inline = "ao")

int fastLen = presetIn == P_W ? 5 : presetIn == P_B ? 13 : presetIn == P_C ? 12 : fastIn
int slowLen = presetIn == P_W ? 34 : presetIn == P_B ? 55 : presetIn == P_C ? 26 : slowIn
int sigLen = presetIn == P_W ? 5 : presetIn == P_B ? 13 : presetIn == P_C ? 9 : sigIn
bool byAtr = normIn == N_ATR

const string GD = "2. Отображение"
const string D_ALL = "Линия + сигнальная + гистограмма"
const string D_LINE = "Только линия"
const string D_HIST = "Только гистограмма"
const string D_AO = "Только AO"
const string D_CUSTOM = "Свои (переключатели ниже)"
string dispIn = input.string(D_ALL, "Пресет отображения", options = [D_ALL, D_LINE, D_HIST, D_AO, D_CUSTOM], group = GD,
     tooltip = "Чтобы держать линию и гистограмму на разных панелях, добавьте индикатор дважды: в одном выберите «Только линия», в другом — «Только гистограмма». Переключатели ниже работают только в режиме «Свои».")
bool cLine = input.bool(true, "Линия MACD (столбики)", group = GD, inline = "d1")
bool cSig = input.bool(true, "Сигнальная", group = GD, inline = "d1")
bool cHist = input.bool(true, "Гистограмма", group = GD, inline = "d2")
bool cAO = input.bool(false, "AO", group = GD, inline = "d2")
bool phaseCol = input.bool(true, "Цвет по фазе", group = GD,
     tooltip = "Яркий цвет — скорость растёт (столбик дальше от нуля, чем предыдущий), бледный — скорость падает. Как у AO.")
int paleTr = input.int(65, "Прозрачность бледного цвета, %", minval = 0, maxval = 95, group = GD)

bool isCustom = dispIn == D_CUSTOM
bool showLine = isCustom ? cLine : dispIn == D_ALL or dispIn == D_LINE
bool showSig = isCustom ? cSig : dispIn == D_ALL
bool showHist = isCustom ? cHist : dispIn == D_ALL or dispIn == D_HIST
bool showAO = isCustom ? cAO : dispIn == D_AO

// Палитра Okabe-Ito (различима при дальтонизме): синий — выше нуля, оранжево-красный — ниже.
color C_UP = #0072B2
color C_DN = #D55E00
color C_AO_UP = #009E73
color C_AO_DN = #CC79A7
color C_SIG = #7F7F7F

// Перевод цены в единицы спидометра: 100 * ln(x) — проценты, иначе цена как есть.
f_tr(float x, bool lg) =>
    lg ? 100.0 * math.log(x) : x

// Ядро спидометра: [MACD, сигнальная, гистограмма, AO] в выбранной нормировке.
// Все ta.* вызываются безусловно при каждом вызове функции (функция вызывается на каждом баре).
f_core(bool lg, int fLen, int sLen, int gLen, bool atrMode, int aLen, int aoF, int aoS) =>
    float srcS = f_tr(close, lg)
    float hiS = f_tr(high, lg)
    float loS = f_tr(low, lg)
    float medS = f_tr(hl2, lg)
    float macdRaw = ta.ema(srcS, fLen) - ta.ema(srcS, sLen)
    float prevS = srcS[1]
    float trS = na(prevS) ? hiS - loS : math.max(hiS - loS, math.abs(hiS - prevS), math.abs(loS - prevS))
    float atrS = ta.rma(trS, aLen)
    float aoRaw = ta.sma(medS, aoF) - ta.sma(medS, aoS)
    float kN = atrMode ? (atrS > 0 ? 1.0 / atrS : na) : 1.0
    float m = macdRaw * kN
    float g = ta.ema(m, gLen)
    [m, g, m - g, aoRaw * kN]

[macdV, sigV, histV, aoV] = f_core(useLog, fastLen, slowLen, sigLen, byAtr, atrLen, aoFast, aoSlow)

// Цвет по фазе: яркий — скорость (модуль) растёт, бледный — падает.
f_phaseCol(float v, float prev, color up, color dn) =>
    color base = v >= 0 ? up : dn
    bool faster = v >= 0 ? v > prev : v < prev
    phaseCol and not faster ? color.new(base, paleTr) : base

color colLine = f_phaseCol(macdV, macdV[1], C_UP, C_DN)
color colHist = f_phaseCol(histV, histV[1], C_UP, C_DN)
color colAO = f_phaseCol(aoV, aoV[1], C_AO_UP, C_AO_DN)

plot(showLine ? macdV : na, "Линия MACD", color = colLine, style = plot.style_columns)
plot(showHist ? histV : na, "Гистограмма", color = colHist, style = plot.style_histogram, linewidth = 3)
plot(showSig ? sigV : na, "Сигнальная", color = C_SIG, linewidth = 1)
plot(showAO ? aoV : na, "AO", color = colAO, style = plot.style_columns)
hline(0, "Ноль", color = color.new(color.gray, 40), linestyle = hline.style_dotted)

// Значения для сверки с reference/speedometer.py (видны в окне данных, на панели не рисуются).
plot(macdV, "Сверка: MACD", display = display.data_window)
plot(sigV, "Сверка: сигнальная", display = display.data_window)
plot(histV, "Сверка: гистограмма", display = display.data_window)
plot(aoV, "Сверка: AO", display = display.data_window)

// ============================================================================
// B. Мультитаймфрейм
// ============================================================================
const string GB = "3. Старшие таймфреймы"
const string H_NONE = "Нет"
const string H_1 = "ТФ 1"
const string H_2 = "ТФ 2"
const string H_3 = "ТФ 3"
const string POS_TL = "Вверху слева"
const string POS_TC = "Вверху по центру"
const string POS_TR = "Вверху справа"
const string POS_ML = "Посередине слева"
const string POS_MR = "Посередине справа"
const string POS_BL = "Внизу слева"
const string POS_BC = "Внизу по центру"
const string POS_BR = "Внизу справа"

bool showMtf = input.bool(true, "Таблица MTF (знак и фаза скорости)", group = GB,
     tooltip = "Для трёх таймфреймов: знак спидометра и фаза — «рост ускоряется / рост замедляется / спад ускоряется / спад замедляется». Значение берётся с последней закрытой свечи старшего ТФ.")
string tf1 = input.timeframe("60", "ТФ 1", group = GB, inline = "tf")
string tf2 = input.timeframe("240", "ТФ 2", group = GB, inline = "tf")
string tf3 = input.timeframe("D", "ТФ 3", group = GB, inline = "tf")
string htfIn = input.string(H_NONE, "Линия старшего ТФ на панели", options = [H_NONE, H_1, H_2, H_3], group = GB,
     tooltip = "Рисует спидометр выбранного ТФ из таблицы ступенчатой линией. Защита от перерисовки: lookahead выключен, на истории берётся значение предыдущей закрытой свечи старшего ТФ. Плата за это — запаздывание на одну свечу старшего ТФ.")
string mtfPosIn = input.string(POS_TR, "Положение таблицы MTF", options = [POS_TL, POS_TC, POS_TR, POS_ML, POS_MR, POS_BL, POS_BC, POS_BR], group = GB)

f_pos(string p) =>
    switch p
        POS_TL => position.top_left
        POS_TC => position.top_center
        POS_TR => position.top_right
        POS_ML => position.middle_left
        POS_MR => position.middle_right
        POS_BL => position.bottom_left
        POS_BC => position.bottom_center
        => position.bottom_right

// Цвета таблиц (в модуле H зависят от темы).
color C_TBL_BG = color.new(color.gray, 85)
color C_TBL_HD = color.new(color.gray, 70)
color C_TBL_TX = color.gray

// Защита от перерисовки (идиома из руководства Pine): на исторических барах — значение
// предыдущей закрытой свечи старшего ТФ ([1] на текущем ТФ), в реальном времени —
// значение [1] самого старшего ТФ. lookahead всегда выключен.
int idxH = barstate.isrealtime ? 1 : 0
int idxC = barstate.isrealtime ? 0 : 1

// Возвращает [MACD, MACD на предыдущей свече] старшего ТФ.
f_htf() =>
    [m, g, h, a] = f_core(useLog, fastLen, slowLen, sigLen, byAtr, atrLen, aoFast, aoSlow)
    [m[idxH], m[idxH + 1]]

// Ровно три вызова request.security.
[q1, q1p] = request.security(syminfo.tickerid, tf1, f_htf(), lookahead = barmerge.lookahead_off)
[q2, q2p] = request.security(syminfo.tickerid, tf2, f_htf(), lookahead = barmerge.lookahead_off)
[q3, q3p] = request.security(syminfo.tickerid, tf3, f_htf(), lookahead = barmerge.lookahead_off)
float m1 = q1[idxC]
float m1p = q1p[idxC]
float m2 = q2[idxC]
float m2p = q2p[idxC]
float m3 = q3[idxC]
float m3p = q3p[idxC]

f_phase(float cur, float prev) =>
    string res = "нет данных"
    if not na(cur) and not na(prev)
        res := cur >= 0 ? (cur > prev ? "рост ускоряется" : "рост замедляется") : (cur < prev ? "спад ускоряется" : "спад замедляется")
    res

string unitTxt = byAtr ? " ATR" : useLog ? " %" : ""

float htfV = htfIn == H_1 ? m1 : htfIn == H_2 ? m2 : htfIn == H_3 ? m3 : na
plot(htfV, "Спидометр старшего ТФ", color = color.new(#E69F00, 0), linewidth = 2, style = plot.style_stepline)

var table mtfTbl = table.new(f_pos(mtfPosIn), 3, 4, border_width = 1)

f_mtfRow(table t, int row, string tf, float cur, float prev, string tsize) =>
    string tfName = tf == "" ? timeframe.period : tf
    bool lower = timeframe.in_seconds(tf) < timeframe.in_seconds()
    string valTxt = lower ? "ТФ ниже графика" : na(cur) ? "—" : (cur >= 0 ? "+" : "") + str.tostring(cur, "#.###") + unitTxt
    string phTxt = lower ? "—" : f_phase(cur, prev)
    color tc = lower or na(cur) ? C_TBL_TX : cur >= 0 ? C_UP : C_DN
    table.cell(t, 0, row, tfName, text_color = C_TBL_TX, bgcolor = C_TBL_BG, text_size = tsize)
    table.cell(t, 1, row, valTxt, text_color = tc, bgcolor = C_TBL_BG, text_size = tsize)
    table.cell(t, 2, row, phTxt, text_color = tc, bgcolor = C_TBL_BG, text_size = tsize)

if barstate.islast and showMtf
    table.cell(mtfTbl, 0, 0, "ТФ", text_color = C_TBL_TX, bgcolor = C_TBL_HD, text_size = size.small)
    table.cell(mtfTbl, 1, 0, "Спидометр", text_color = C_TBL_TX, bgcolor = C_TBL_HD, text_size = size.small)
    table.cell(mtfTbl, 2, 0, "Фаза скорости", text_color = C_TBL_TX, bgcolor = C_TBL_HD, text_size = size.small)
    f_mtfRow(mtfTbl, 1, tf1, m1, m1p, size.small)
    f_mtfRow(mtfTbl, 2, tf2, m2, m2p, size.small)
    f_mtfRow(mtfTbl, 3, tf3, m3, m3p, size.small)

// ============================================================================
// C. Дивергенции
// Сигнал появляется с задержкой «баров справа»: пивот подтверждается только через
// pR закрытых баров. Это не перерисовка (нарисованное не меняется), но и не опережение.
// ============================================================================
const string GC = "4. Дивергенции"
const string S_LINE = "Линия MACD"
const string S_HIST = "Гистограмма"
const string S_AO = "AO"
const string M_PAIR = "Пары пивотов"
const string M_THREE = "Три пика (1-3-5)"
const string M_BOTH = "Оба режима"

bool showDiv = input.bool(true, "Показывать дивергенции", group = GC)
string divSrcIn = input.string(S_LINE, "Источник", options = [S_LINE, S_HIST, S_AO], group = GC,
     tooltip = "По какому ряду искать пивоты индикатора.")
string divModeIn = input.string(M_PAIR, "Режим", options = [M_PAIR, M_THREE, M_BOTH], group = GC,
     tooltip = "«Пары пивотов» — обычные и скрытые дивергенции между двумя соседними пивотами. «Три пика» — сравнение трёх последних пиков (например, волн 1-3-5): подпись «затухание», если каждый следующий пик слабее, и «возрастание», если сильнее, при этом цена обновляет экстремумы.")
bool showReg = input.bool(true, "Обычные", group = GC, inline = "dk")
bool showHid = input.bool(true, "Скрытые", group = GC, inline = "dk")
int pL = input.int(5, "Пивот: баров слева", minval = 1, maxval = 50, group = GC, inline = "pv")
int pR = input.int(5, "справа", minval = 1, maxval = 50, group = GC, inline = "pv",
     tooltip = "Баров справа = задержка сигнала. Дивергенция рисуется через столько закрытых баров после пивота.")
int minDist = input.int(5, "Расстояние между пивотами: мин.", minval = 1, group = GC, inline = "ds")
int maxDist = input.int(80, "макс.", minval = 2, group = GC, inline = "ds")
int priceWin = input.int(2, "Окно поиска экстремума цены, баров в каждую сторону", minval = 0, maxval = 50, group = GC,
     tooltip = "Цена сравнивается по минимуму low (для впадин) или максимуму high (для пиков) в окне вокруг пивота индикатора, а не по close. Окно не может быть больше «баров справа».")
bool zeroFilter = input.bool(true, "Обычные: бычьи только ниже нуля, медвежьи — выше", group = GC,
     tooltip = "Фильтр применяется к обычным дивергенциям (оба пивота по одну сторону нуля). Скрытые дивергенции — признак продолжения тренда, их пивоты бывают по любую сторону нуля, фильтр к ним не применяется.")
float minDiffPct = input.float(5.0, "Мин. разница значений индикатора, % от диапазона", minval = 0.0, maxval = 100.0, step = 0.5, group = GC,
     tooltip = "Отсекает шумовые дивергенции: |разница двух пивотов| должна быть не меньше этой доли от (максимум - минимум) индикатора за период ниже.")
int rangeLen = input.int(200, "Период диапазона индикатора, баров", minval = 10, group = GC)
bool divOnPrice = input.bool(false, "Дублировать на графике цены", group = GC,
     tooltip = "Линии и метки дивергенций рисуются и на основном графике (force_overlay).")
int maxDivObj = input.int(40, "Хранить последних дивергенций", minval = 1, maxval = 100, group = GC,
     tooltip = "Старые линии и метки удаляются (массив + delete), чтобы не упереться в лимит объектов (500).")

bool modePairs = divModeIn != M_THREE
bool modeThree = divModeIn != M_PAIR

float osc = divSrcIn == S_LINE ? macdV : divSrcIn == S_HIST ? histV : aoV

// Все ta.* — на глобальном уровне, на каждом баре.
int wEff = math.min(priceWin, pR)
float phV = ta.pivothigh(osc, pL, pR)
float plV = ta.pivotlow(osc, pL, pR)
float loWin = ta.lowest(low, 2 * wEff + 1)
float hiWin = ta.highest(high, 2 * wEff + 1)
float pxLoAtPivot = loWin[pR - wEff]    // минимум low в [пивот - w; пивот + w]
float pxHiAtPivot = hiWin[pR - wEff]    // максимум high в [пивот - w; пивот + w]
float oscRange = ta.highest(osc, rangeLen) - ta.lowest(osc, rangeLen)

// Состояние: три последних пивота каждого типа (бар, значение индикатора, цена).
var array<int> loBar = array.new<int>()
var array<float> loOsc = array.new<float>()
var array<float> loPx = array.new<float>()
var array<int> hiBar = array.new<int>()
var array<float> hiOsc = array.new<float>()
var array<float> hiPx = array.new<float>()

var array<line> divLines = array.new<line>()
var array<label> divLabels = array.new<label>()

f_keepLine(array<line> arr, line ln, int maxN) =>
    arr.push(ln)
    if arr.size() > maxN
        arr.shift().delete()

f_keepLabel(array<label> arr, label lb, int maxN) =>
    arr.push(lb)
    if arr.size() > maxN
        arr.shift().delete()

f_pushPivot(array<int> b, array<float> o, array<float> p, int bar, float ov, float pv) =>
    b.push(bar)
    o.push(ov)
    p.push(pv)
    if b.size() > 3
        b.shift()
        o.shift()
        p.shift()

color C_BULL = C_UP
color C_BEAR = C_DN

// Рисует дивергенцию: на панели (по значениям индикатора) и, опционально, на цене.
// Обычные — сплошная линия, скрытые — пунктир; тип подписан текстом (цвет не единственный носитель смысла).
f_drawDiv(int x1, float y1, int x2, float y2, float px1, float px2, bool bull, bool hidden, string txt) =>
    color c = bull ? C_BULL : C_BEAR
    string st = hidden ? line.style_dashed : line.style_solid
    string lst = bull ? label.style_label_up : label.style_label_down
    int keepN = maxDivObj * (divOnPrice ? 4 : 2)
    f_keepLine(divLines, line.new(x1, y1, x2, y2, color = c, style = st, width = 2), keepN)
    if txt != ""
        f_keepLabel(divLabels, label.new(x2, y2, txt, color = color.new(c, 15), textcolor = color.white, style = lst, size = size.tiny), keepN)
    if divOnPrice
        f_keepLine(divLines, line.new(x1, px1, x2, px2, color = c, style = st, width = 2, force_overlay = true), keepN)
        if txt != ""
            f_keepLabel(divLabels, label.new(x2, px2, txt, color = color.new(c, 15), textcolor = color.white, style = lst, size = size.tiny, force_overlay = true), keepN)

bool bullReg = false
bool bullHid = false
bool bearReg = false
bool bearHid = false
bool threeFade = false
bool threeGrow = false

// --- впадины индикатора: бычьи дивергенции
if not na(plV)
    int cb = bar_index - pR
    float co = plV
    float cp = pxLoAtPivot
    if loBar.size() > 0 and modePairs and not na(cp)
        int pb = loBar.last()
        float po = loOsc.last()
        float pp = loPx.last()
        int dist = cb - pb
        bool distOk = dist >= minDist and dist <= maxDist
        bool diffOk = not na(oscRange) and math.abs(co - po) >= minDiffPct / 100.0 * oscRange
        bool zeroOk = not zeroFilter or (co < 0 and po < 0)
        if distOk and diffOk
            if showReg and zeroOk and cp < pp and co > po
                bullReg := true
                if showDiv
                    f_drawDiv(pb, po, cb, co, pp, cp, true, false, "Бычья")
            if showHid and cp > pp and co < po
                bullHid := true
                if showDiv
                    f_drawDiv(pb, po, cb, co, pp, cp, true, true, "Скр. бычья")
    f_pushPivot(loBar, loOsc, loPx, cb, co, cp)
    if modeThree and loBar.size() == 3 and not na(loPx.get(0)) and not na(loPx.get(1)) and not na(cp)
        float o1 = loOsc.get(0)
        float o2 = loOsc.get(1)
        float p1 = loPx.get(0)
        float p2 = loPx.get(1)
        if p1 > p2 and p2 > cp
            bool fade = o1 < o2 and o2 < co
            bool grow = o1 > o2 and o2 > co
            if fade or grow
                threeFade := threeFade or fade
                threeGrow := threeGrow or grow
                if showDiv
                    f_drawDiv(loBar.get(0), o1, loBar.get(1), o2, p1, p2, true, not fade, "")
                    f_drawDiv(loBar.get(1), o2, cb, co, p2, cp, true, not fade, fade ? "Затухание" : "Возрастание")

// --- пики индикатора: медвежьи дивергенции
if not na(phV)
    int cb = bar_index - pR
    float co = phV
    float cp = pxHiAtPivot
    if hiBar.size() > 0 and modePairs and not na(cp)
        int pb = hiBar.last()
        float po = hiOsc.last()
        float pp = hiPx.last()
        int dist = cb - pb
        bool distOk = dist >= minDist and dist <= maxDist
        bool diffOk = not na(oscRange) and math.abs(co - po) >= minDiffPct / 100.0 * oscRange
        bool zeroOk = not zeroFilter or (co > 0 and po > 0)
        if distOk and diffOk
            if showReg and zeroOk and cp > pp and co < po
                bearReg := true
                if showDiv
                    f_drawDiv(pb, po, cb, co, pp, cp, false, false, "Медвежья")
            if showHid and cp < pp and co > po
                bearHid := true
                if showDiv
                    f_drawDiv(pb, po, cb, co, pp, cp, false, true, "Скр. медвежья")
    f_pushPivot(hiBar, hiOsc, hiPx, cb, co, cp)
    if modeThree and hiBar.size() == 3 and not na(hiPx.get(0)) and not na(hiPx.get(1)) and not na(cp)
        float o1 = hiOsc.get(0)
        float o2 = hiOsc.get(1)
        float p1 = hiPx.get(0)
        float p2 = hiPx.get(1)
        if p1 < p2 and p2 < cp
            bool fade = o1 > o2 and o2 > co
            bool grow = o1 < o2 and o2 < co
            if fade or grow
                threeFade := threeFade or fade
                threeGrow := threeGrow or grow
                if showDiv
                    f_drawDiv(hiBar.get(0), o1, hiBar.get(1), o2, p1, p2, false, not fade, "")
                    f_drawDiv(hiBar.get(1), o2, cb, co, p2, cp, false, not fade, fade ? "Затухание" : "Возрастание")

// ============================================================================
// D. Слепая зона на панели
// Слепая зона — участок от экстремума цены текущего режима до пересечения EMA fast/slow
// (= смены знака линии MACD). Пока пересечения нет, линия показывает старый тренд.
// Состояние ведётся «на ходу» через var, без циклов по истории.
// ============================================================================
const string GZ = "5. Слепая зона"
const string Z_OFF = "Выкл"
const string Z_BOX = "Боксы (после пересечения)"
const string Z_BG = "Фон (на ходу)"
const string Z_BOTH = "Боксы и фон"
string bzIn = input.string(Z_BOX, "Подсветка слепой зоны", options = [Z_OFF, Z_BOX, Z_BG, Z_BOTH], group = GZ,
     tooltip = "Боксы: зона рисуется от бара экстремума до бара пересечения, когда пересечение уже случилось; текущая (ещё не закрытая) зона — пунктирный бокс до последнего бара. Фон: подсвечиваются бары после последнего экстремума режима, пока знак линии не сменился; если цена обновит экстремум, уже подсвеченные бары останутся подсвеченными — это «возможная» слепая зона.")
int maxZones = input.int(30, "Хранить последних зон", minval = 1, maxval = 200, group = GZ)

bool bzBoxes = bzIn == Z_BOX or bzIn == Z_BOTH
bool bzBg = bzIn == Z_BG or bzIn == Z_BOTH

var int bzReg = 0           // 1 — линия выше нуля (EMA fast > slow), -1 — ниже
var float bzExt = na        // экстремум цены режима (high для роста, low для спада)
var int bzExtBar = na       // бар экстремума
int bzNew = macdV > 0 ? 1 : macdV < 0 ? -1 : bzReg

// Обновление экстремума в текущем режиме (бар пересечения тоже входит в зону).
if bzReg == 1 and high > bzExt
    bzExt := high
    bzExtBar := bar_index
else if bzReg == -1 and low < bzExt
    bzExt := low
    bzExtBar := bar_index

bool bzEnd = false          // на этом баре слепая зона закончилась (смена знака линии)
int bzEndReg = 0
int bzZoneStart = na
if bzNew != bzReg and bzNew != 0
    if bzReg != 0
        bzEnd := true
        bzEndReg := bzReg
        bzZoneStart := bzExtBar
    bzExt := bzNew == 1 ? high : low
    bzExtBar := bar_index
bzReg := bzNew

float bzH = ta.highest(math.abs(macdV), 100)    // высота боксов на панели
var array<box> bzBoxArr = array.new<box>()
var box bzLiveBox = na

if bzBoxes and bzEnd and not na(bzH)
    color zc = bzEndReg == 1 ? C_UP : C_DN
    bzBoxArr.push(box.new(bzZoneStart, bzH, bar_index, -bzH, border_color = color.new(zc, 60),
         bgcolor = color.new(zc, 88), text = "слепая зона", text_size = size.tiny,
         text_color = color.new(zc, 30), text_valign = text.align_top))
    if bzBoxArr.size() > maxZones
        bzBoxArr.shift().delete()

if barstate.islast and bzBoxes and bzReg != 0 and not na(bzH)
    color lc = bzReg == 1 ? C_UP : C_DN
    if na(bzLiveBox)
        bzLiveBox := box.new(bzExtBar, bzH, bar_index, -bzH, border_style = line.style_dashed,
             text = "слепая зона?", text_size = size.tiny, text_valign = text.align_top)
    box.set_lefttop(bzLiveBox, bzExtBar, bzH)
    box.set_rightbottom(bzLiveBox, bar_index, -bzH)
    box.set_border_color(bzLiveBox, color.new(lc, 50))
    box.set_bgcolor(bzLiveBox, color.new(lc, 92))
    box.set_text_color(bzLiveBox, color.new(lc, 30))

bool bzLive = bzReg != 0 and bar_index > bzExtBar
bgcolor(bzBg and bzLive ? color.new(color.gray, 88) : na, title = "Слепая зона (на ходу)")
